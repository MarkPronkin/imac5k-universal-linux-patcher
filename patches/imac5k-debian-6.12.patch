+		if (!other || other == root || other == link || !other->ddc ||
+		    other->connector_signal != SIGNAL_TYPE_DISPLAY_PORT)
+			continue;
+		if (apple_tiled_slave_poll_aux(other, root)) {
+			link->tiled_peer = NULL;
+			root->tiled_peer = other;
+			other->tiled_peer = root;
+			return false;
+		}
+	}
+	return false;
