+	mutex_lock(&adev->dm.dc_lock);
+	if (!adev->dm.tiled_resync_stopping && !adev->dm.dc->apple_5k_going_down &&
+	    !adev->in_suspend && !amdgpu_in_reset(adev)) {
+		if (modeset) {
+			adev->dm.tiled_link_checks = APPLE5K_LINK_CHECKS;
+			adev->dm.tiled_link_recoveries = 0;
+			drm_info(adev_to_drm(adev),
+				 "APPLE5K: link-health armed after tiled modeset: checks=%u\n",
+				 APPLE5K_LINK_CHECKS);
+		}
+		adev->dm.tiled_sync_pending = true;
+		/* Ordinary plane commits must not postpone an already armed check.
+		 * A modeset must: a pass queued by the previous commit can otherwise
+		 * fire between this commit's phases and run the timing sync while a
+		 * timing generator is down ("TG counter is not moving!", "GSL:
+		 * Timeout on reset trigger!"). The sequence armed above observes the
+		 * new state once it has settled.
+		 */
+		if (modeset)
+			mod_delayed_work(system_wq, &adev->dm.tiled_resync_work,
+					 msecs_to_jiffies(APPLE5K_LINK_SETTLE_MS));
+		else
+			queue_delayed_work(system_wq, &adev->dm.tiled_resync_work,
+					   msecs_to_jiffies(APPLE5K_LINK_SETTLE_MS));
+	} else if (modeset && adev->in_suspend && !adev->dm.tiled_resync_stopping &&
+		   !adev->dm.dc->apple_5k_going_down && !amdgpu_in_reset(adev)) {
+		/* The resume commit. amdgpu_dm_apple5k_resume_complete() arms it once in_suspend clears. */
+		adev->dm.tiled_resume_modeset = true;
+	}
+	mutex_unlock(&adev->dm.dc_lock);
+}
