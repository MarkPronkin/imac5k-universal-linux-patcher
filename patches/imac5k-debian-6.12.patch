+	/* Reserve the last observation for verification, not another reset. */
+	if (adev->dm.tiled_link_recoveries >= APPLE5K_LINK_RECOVERIES ||
+	    adev->dm.tiled_link_checks <= 1) {
+		drm_err(adev_to_drm(adev),
+			"APPLE5K: link-health FAIL: unrecovered after %u attempts root=%d slave=%d\n",
+			adev->dm.tiled_link_recoveries, root_ready, slave_ready);
+		return false;
+	}
+	adev->dm.tiled_link_recoveries++;
+	adev->dm.tiled_sync_pending = true;
+	drm_warn(adev_to_drm(adev),
+		 "APPLE5K: link-health recovery %u/%u root=%d slave=%d\n",
+		 adev->dm.tiled_link_recoveries, APPLE5K_LINK_RECOVERIES,
+		 root_ready, slave_ready);
+	if (!root_ready)
+		dc_link_dp_handle_link_loss(root);
+	/* A root restart can reset the shared panel. Bring the slave up last. */
+	dc_link_dp_handle_link_loss(slave);
+	return true;
+}
