+	if (!dc_link_is_apple_tiled_slave(link) || !link->ddc)
+		return false;
+	if (apple_tiled_slave_poll_aux(link, root))
+		return true;
+	if (!root)
+		return false;
+
+	for (i = 0; i < root->dc->link_count; i++) {
+		struct dc_link *other = root->dc->links[i];
