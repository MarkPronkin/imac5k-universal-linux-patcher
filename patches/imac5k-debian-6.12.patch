+static void amdgpu_dm_tiled_resync_work(struct work_struct *work)
+{
+	struct amdgpu_display_manager *dm =
+		container_of(to_delayed_work(work), struct amdgpu_display_manager,
+			     tiled_resync_work);
+	struct amdgpu_device *adev = dm->adev;
+	struct dc *dc = dm->dc;
+	int i;
+
+	mutex_lock(&dm->dc_lock);
+	if (dm->tiled_resync_stopping || !dc || dc->apple_5k_going_down ||
+	    adev->in_suspend || amdgpu_in_reset(adev)) {
+		if (dm->tiled_link_checks)
+			drm_info(adev_to_drm(adev),
+				 "APPLE5K: link-health pass skipped: stopping=%d going_down=%d suspend=%d reset=%d\n",
+				 dm->tiled_resync_stopping,
+				 dc && dc->apple_5k_going_down, adev->in_suspend,
+				 amdgpu_in_reset(adev));
+		goto out;
+	}
+
+	if (dm->tiled_link_checks) {
+		drm_info(adev_to_drm(adev),
+			 "APPLE5K: link-health pass %u/%u recoveries=%u\n",
+			 APPLE5K_LINK_CHECKS - dm->tiled_link_checks + 1,
+			 APPLE5K_LINK_CHECKS, dm->tiled_link_recoveries);
+		if (!amdgpu_dm_tiled_check_links(adev))
+			dm->tiled_link_checks = 0;
+		else if (!--dm->tiled_link_checks)
+			drm_info(adev_to_drm(adev),
+				 "APPLE5K: link-health PASS: both tiles healthy after %u recovery attempts\n",
+				 dm->tiled_link_recoveries);
+	}
+
+	if (dc->current_state && dm->tiled_sync_pending) {
+		for (i = 0; i < dc->current_state->stream_count; i++)
+			dc->current_state->streams[i]->triggered_crtc_reset.enabled =
+				dm->force_timing_sync;
+		dm_enable_per_frame_crtc_master_sync(dc->current_state);
+		dc_trigger_sync(dc, dc->current_state);
+	}
+	dm->tiled_sync_pending = false;
+	/* Read again after recovery AND timing sync. Neither an immediate lock
+	 * read nor successful training establishes that scanout remains healthy.
+	 */
+	if (dm->tiled_link_checks)
+		mod_delayed_work(system_wq, &dm->tiled_resync_work,
+				 msecs_to_jiffies(APPLE5K_LINK_RECHECK_MS));
+out:
+	mutex_unlock(&dm->dc_lock);
+}
