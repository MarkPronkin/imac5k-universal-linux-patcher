+/* Detect-time root wake: the DDC must be in AUX mode (and stays there). */
+static void apple_tiled_root_wake(struct dc_link *link)
+{
+	if (!dc_link_is_apple_tiled_root(link) || !link->ddc)
+		return;
+	set_ddc_transaction_type(link->ddc, DDC_TRANSACTION_TYPE_I2C_OVER_AUX);
+	link->aux_mode = link_is_in_aux_transaction_mode(link->ddc);
+	link_apple_5k_root_panel_latch_pulse(link);
+}
+
+/*
+ * Wake the panel through the root and wait for this DP link's AUX to answer.
+ * A slave-only re-detect never runs the root's detect, so the wake has to be
+ * re-asserted here; at boot it is an idempotent repeat.
+ */
+static bool apple_tiled_slave_poll_aux(struct dc_link *link,
+				       struct dc_link *root_link)
+{
+	enum ddc_transaction_type old_type = link->ddc->transaction_type;
+	bool old_aux_mode = link->aux_mode;
+	unsigned int elapsed_ms;
+	uint8_t rev;
+
+	set_ddc_transaction_type(link->ddc, DDC_TRANSACTION_TYPE_I2C_OVER_AUX);
+	link->aux_mode = link_is_in_aux_transaction_mode(link->ddc);
+	apple_tiled_root_wake(root_link);
+
+	for (elapsed_ms = 0; ; elapsed_ms += TILED_SLAVE_AUX_WAKE_POLL_MS) {
+		rev = 0;
+		if (core_link_read_dpcd(link, DP_DPCD_REV, &rev, 1) == DC_OK && rev)
+			return true;
+		if (elapsed_ms >= TILED_SLAVE_AUX_WAKE_TIMEOUT_MS)
+			break;
+		msleep(TILED_SLAVE_AUX_WAKE_POLL_MS);
+	}
+	set_ddc_transaction_type(link->ddc, old_type);
+	link->aux_mode = old_aux_mode;
+	return false;
+}
