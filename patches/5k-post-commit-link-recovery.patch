  * So: after every commit that touches the tiled pair, re-run the sync a short
  * while later, via the same routine the debugfs force_timing_sync knob uses.
  */
+/* A stream-enable check can pass before the tile loses AUX or main-link
+ * lock later in the commit. HPD-RX recovery cannot help when its status read
+ * fails. Observe settled scanout, and use DC's full link-loss sequence rather
+ * than sending training patterns into an otherwise live stream.
+ */
+static bool amdgpu_dm_tiled_link_ready(struct amdgpu_device *adev,
+				      struct dc_link *link)
+{
+	u8 status[DP_LINK_STATUS_SIZE] = {0};
+	unsigned int lanes = link->cur_link_settings.lane_count;
+	enum dc_status ret;
+	bool ready;
+
+	ret = core_link_read_dpcd(link, DP_LANE0_1_STATUS, status, sizeof(status));
+	ready = ret == DC_OK && lanes == 4 &&
+		drm_dp_channel_eq_ok(status, lanes) &&
+		(status[DP_SINK_STATUS - DP_LANE0_1_STATUS] & DP_RECEIVE_PORT_0_STATUS);
+	drm_info(adev_to_drm(adev),
+		 "APPLE5K: link-health link[%u] aux=%d lanes=%u status=%*ph ready=%d\n",
+		 link->link_index, ret, lanes, (int)sizeof(status), status, ready);
+	return ready;
+}
+
+/* Caller holds dc_lock. Never resurrect a DPMS-off or disappearing stream. */
+static bool amdgpu_dm_tiled_check_links(struct amdgpu_device *adev)
+{
+	struct dc *dc = adev->dm.dc;
+	struct dc_link *root = NULL, *slave = NULL;
+	bool root_ready, slave_ready;
+	int i;
+
+	if (!dc->current_state) {
+		drm_warn(adev_to_drm(adev),
+			 "APPLE5K: link-health disarmed: no dc state\n");
+		return false;
+	}
+	for (i = 0; i < dc->current_state->stream_count; i++) {
+		struct dc_stream_state *stream = dc->current_state->streams[i];
+		struct dc_link *link = stream->link;
+
+		if (stream->dpms_off || !link->local_sink || link->aux_access_disabled)
+			continue;
+		if (amdgpu_dm_link_is_tiled_stitch_root(link))
+			root = link;
+		else if (amdgpu_dm_link_is_tiled_stitch_slave(link))
+			slave = link;
+	}
+	if (!root || !slave || root->tiled_peer != slave || slave->tiled_peer != root) {
+		drm_warn(adev_to_drm(adev),
+			 "APPLE5K: link-health disarmed: no active tiled pair root=%d slave=%d paired=%d streams=%u\n",
+			 !!root, !!slave,
+			 root && slave && root->tiled_peer == slave &&
+				 slave->tiled_peer == root,
+			 dc->current_state->stream_count);
+		return false;
+	}
+
+	root_ready = amdgpu_dm_tiled_link_ready(adev, root);
+	slave_ready = amdgpu_dm_tiled_link_ready(adev, slave);
+	if (root_ready && slave_ready)
+		return true;
+
+	/* Reserve the last observation for verification, not another reset. */
+	if (adev->dm.tiled_link_recoveries >= APPLE5K_LINK_RECOVERIES ||
+	    adev->dm.tiled_link_checks <= 1) {
+		drm_err(adev_to_drm(adev),
+			"APPLE5K: link-health FAIL: unrecovered after %u attempts root=%d slave=%d\n",
+			adev->dm.tiled_link_recoveries, root_ready, slave_ready);
+		return false;
+	}
+	adev->dm.tiled_link_recoveries++;
+	adev->dm.tiled_sync_pending = true;
+	drm_warn(adev_to_drm(adev),
+		 "APPLE5K: link-health recovery %u/%u root=%d slave=%d\n",
+		 adev->dm.tiled_link_recoveries, APPLE5K_LINK_RECOVERIES,
+		 root_ready, slave_ready);
+	if (!root_ready)
+		dc_link_dp_handle_link_loss(root);
+	/* A root restart can reset the shared panel. Bring the slave up last. */
+	dc_link_dp_handle_link_loss(slave);
+	return true;
+}
