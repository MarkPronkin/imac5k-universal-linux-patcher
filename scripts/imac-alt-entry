#!/usr/bin/env bash
#
# imac-alt-entry — boot ANY amdgpu build from its own boot entry, without
# touching /usr/lib/modules, the default boot image, or any other test entry.
#
# Complements imac-test-entry (which swaps the default and the single test
# slot). This one builds a *separate* UKI (Limine) or initramfs (GRUB) from a
# module you point it at:
#
#   default entry   ->  omarchy_linux.efi              (known-good, untouched)
#   /Test - <name>  ->  omarchy_linux-<name>.efi       (the build you name)
#
# How it works: the running kernel's module tree is copied to a scratch root,
# the amdgpu module is swapped there, depmod is run on the copy, and
# mkinitcpio --moduleroot builds a UKI from it. The kms hook + MODULES=(amdgpu)
# bake the module into the initramfs, so the entry you pick decides which
# amdgpu loads. Nothing under / changes except the new .efi and the entry.
#
#   sudo imac-alt-entry add  <name> <amdgpu.ko | amdgpu.ko.zst>
#   sudo imac-alt-entry promote <name>   make that build the default; keeps the old module as .prev-promote
#   sudo imac-alt-entry drop <name>
#        imac-alt-entry list
#
# Optional: IMAC_CMDLINE="..." overrides the kernel cmdline (default: the
# cmdline of the default entry in /boot/limine.conf). Limine only — on GRUB the
# entry inherits the generated cmdline from grub.cfg.
#
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
source "${SCRIPT_DIR}/lib/platform.sh"
if imac_is_fedora; then
    echo "This helper is for Omarchy/Limine and Arch-family GRUB, not Fedora." >&2
    exit 1
fi


KREL="$(uname -r)"
ESP=/boot
CONF="${ESP}/limine.conf"
UKIDIR="${ESP}/EFI/Linux"
MODREL="kernel/drivers/gpu/drm/amd/amdgpu/amdgpu.ko.zst"

say() { printf '\033[1;33m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;31m!!\033[0m %s\n' "$*" >&2; }
die() { printf '\033[1;31mERROR:\033[0m %s\n' "$*" >&2; exit 1; }
need_root() { [[ $EUID -eq 0 ]] || die "run with sudo"; }

check_name() {
	[[ ${1:-} =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$ ]] || die "name must be [A-Za-z0-9._-], max 32 chars"
}
marker() { printf '/Test - %s' "$1"; }
uki_path() { printf '%s/omarchy_linux-%s.efi' "$UKIDIR" "$1"; }

# Limine >= 10.3.0 loads the FIRST limine.conf in its search order; copies at
# EFI/limine/ or EFI/BOOT/ shadow the canonical /boot/limine.conf. Remove them.
sync_conf() {
	local f
	for f in "${ESP}/EFI/limine/limine.conf" "${ESP}/EFI/BOOT/limine.conf" \
		"${ESP}/boot/limine/limine.conf" "${ESP}/limine/limine.conf"; do
		[[ -f $f ]] && rm -f "$f"
	done
	sync
}

# Remove one entry block: from its marker line through its cmdline: line.
remove_entry() {
	local m; m="$(marker "$1")"
	grep -qF "$m" "$CONF" || return 0
	python3 - "$CONF" "$m" <<'PY'
import sys,re
p,m=sys.argv[1],sys.argv[2]
lines=open(p).read().split("\n"); out=[]; i=0
while i<len(lines):
    if lines[i].startswith(m):
        while i<len(lines) and not lines[i].startswith("cmdline:"): i+=1
        i+=1
        while out and out[-1].strip()=="" : out.pop()
        continue
    out.append(lines[i]); i+=1
s="\n".join(out).rstrip("\n")+"\n"
open(p,"w").write(s)
PY
}

# Insert the entry before any imac-test-entry block (whose `drop` deletes from
# its marker to end-of-file), otherwise append.
add_entry() {   # add_entry <name> <uki> <cmdline> <module-basename>
	local hash block
	hash="$(b2sum "$2" | cut -d' ' -f1)"
	block="$(cat <<EOB

$(marker "$1") (remove after confirming)
### Added by imac-alt-entry, not by limine-entry-tool. A config regeneration
### may drop it; that leaves the known-good default, which is the safe outcome.
comment: module=$4 built=$(date -u +%Y-%m-%dT%H:%MZ)
protocol: efi
path: boot():/EFI/Linux/$(basename "$2")#${hash}
cmdline: $3
EOB
)"
	python3 - "$CONF" "$block" <<'PY'
import sys
p,block=sys.argv[1],sys.argv[2]
s=open(p).read().rstrip("\n")
lines=s.split("\n")
idx=next((i for i,l in enumerate(lines) if l.startswith("/Test - 5K boot fixes")),None)
if idx is None:
    s=s+"\n"+block+"\n"
else:
    s="\n".join(lines[:idx]).rstrip("\n")+"\n"+block+"\n\n"+"\n".join(lines[idx:])+"\n"
open(p,"w").write(s)
PY
}

# limine-mkinitcpio regenerates limine.conf and may drop our hand-added entries.
# Any of our UKIs still on disk without an entry gets its entry back, hash-pinned.
repin_orphans() {
	local efi name cmdline
	cmdline="$(grep -m1 '^  cmdline:' "$CONF" | sed 's/^  cmdline: //')"
	for efi in "$UKIDIR"/omarchy_linux-*.efi; do
		[[ -f $efi ]] || continue
		name="$(basename "$efi" .efi)"; name="${name#omarchy_linux-}"
		[[ $name == 5ktest ]] && continue      # imac-test-entry's slot, not ours
		grep -qF "$(marker "$name")" "$CONF" && continue
		say "re-pinning '$(marker "$name")' after the config regeneration"
		add_entry "$name" "$efi" "$cmdline" "(re-pinned)"
	done
}

module_desc() {   # module_desc <.ko.zst>
	local syms marks=()
	syms="$(zstd -dcf "$1" 2>/dev/null | strings || true)"
	# "APPLE5K: stream[" is the core's per-commit stream dump; the stitch layer
	# carries one APPLE5K-prefixed line of its own, so test for the core's.
	if   [[ $syms == *"APPLE5K: stream["* ]]; then marks+=("verbose-core")
	elif [[ $syms == *tiled_stitch* || $syms == *"panel latch"* ]]; then marks+=("lean-core"); fi
	[[ $syms == *tiled_stitch* ]]            && marks+=("stitch")
	[[ $syms == *"stream-disable latch"* ]]  && marks+=("latch-clear")
	((${#marks[@]})) && (IFS=+; echo "${marks[*]}") || echo "stock"
}

uki_module() {    # uki_module <uki> <dest.ko.zst>
	local img; img="$(mktemp)"
	objcopy -O binary --only-section=.initrd "$1" "$img" 2>/dev/null || { rm -f "$img"; return 1; }
	bsdtar -xOf "$img" "usr/lib/modules/*/$MODREL" > "$2" 2>/dev/null || { rm -f "$img"; return 1; }
	rm -f "$img"; [[ -s $2 ]]
}

# ── GRUB backend (Arch family) ─────────────────────────────────────────────
# Same idea with GRUB mechanics: a named test build lives in its own initramfs
# image at /boot/initramfs-<pkgbase>-imac-<name>.img, booted by a cloned
# grub.cfg entry in /etc/grub.d/40_custom. The default entry and its image are
# untouched until promote.
if imac_is_arch_grub; then
	source "${SCRIPT_DIR}/lib/grub.sh"
	PKGBASE="$(imac_kernel_pkgbase "$KREL")"
	DEFAULT_IMG="$GRUB_BOOT_DIR/initramfs-${PKGBASE}.img"

	grub_add() {   # grub_add <name> <amdgpu.ko|amdgpu.ko.zst>
		need_root; NAME="${1:-}"; SRC="${2:-}"
		check_name "$NAME"; [[ -f ${SRC:-} ]] || die "usage: sudo $0 add <name> <amdgpu.ko|amdgpu.ko.zst>"
		grub_require_layout || die "unsupported or stale GRUB boot layout"
		IMG="$(grub_image_path "$NAME")"
		[[ -d $GRUB_MODULES_DIR/$KREL ]] || die "no module tree for $KREL"

		WORK="$(mktemp -d)"; trap 'rm -rf "$WORK"' EXIT
		MOD="$WORK/amdgpu.ko.zst"
		grub_prepare_module "$SRC" "$MOD" || die "invalid test module"

		say "staging a private copy of the $KREL module tree"
		ALT="$WORK/root"; mkdir -p "$ALT/usr/lib/modules"; ln -s usr/lib "$ALT/lib"
		rsync -a --exclude build --exclude '*.stock-backup' --exclude '*.prev-*' \
			"$GRUB_MODULES_DIR/$KREL" "$ALT/usr/lib/modules/"
		install -m644 "$MOD" "$ALT/usr/lib/modules/$KREL/$MODREL"
		depmod -b "$ALT" "$KREL"

		say "building test initramfs $(basename "$IMG") with mkinitcpio --moduleroot"
		grub_build_image "$WORK/test.img" "$ALT" >"$WORK/mkinitcpio.log" 2>&1 \
			|| { tail -20 "$WORK/mkinitcpio.log"; die "mkinitcpio failed"; }

		say "verifying the image carries exactly the module you gave"
		grub_image_module "$WORK/test.img" "$WORK/inside.ko.zst" \
			|| die "no amdgpu module found inside the built image"
		[[ "$(zstd -dcf "$WORK/inside.ko.zst" | b2sum)" == "$(zstd -dcf "$MOD" | b2sum)" ]] \
			|| die "module inside the image differs from the one given — refusing to install"

		install -m644 "$WORK/test.img" "$IMG"; sync
		grub_clone_entry "$NAME" "$IMG" || die "could not add the GRUB entry"
		say "done — '/Test - $NAME' boots $(module_desc "$MOD"); default entry untouched"
		grub_list
	}

	grub_promote() {   # grub_promote <name>
		need_root; NAME="${1:-}"; check_name "$NAME"
		grub_require_layout || die "unsupported or stale GRUB boot layout"
		IMG="$(grub_image_path "$NAME")"; [[ -f $IMG ]] || die "no image for '$NAME' at $IMG"
		grub_entry_exists "$NAME" || die "no entry '/Test - $NAME' in $GRUB_CUSTOM"
		WORK="$(mktemp -d)"; trap 'rm -rf "$WORK"' EXIT
		CUR="$GRUB_MODULES_DIR/$KREL/$MODREL"

		say "extracting the module that '/Test - $NAME' boots"
		grub_image_module "$IMG" "$WORK/new.ko.zst" || die "no amdgpu module inside $IMG"
		vm="$(modinfo -F vermagic "$WORK/new.ko.zst" 2>/dev/null | awk '{print $1}')"
		[[ $vm == "$KREL" ]] || die "module vermagic '$vm' != running kernel '$KREL'"

		say "keeping the current default module beside it as amdgpu.ko.zst.prev-promote"
		cp -f "$CUR" "$CUR.prev-promote"
		install -m644 "$WORK/new.ko.zst" "$CUR"
		depmod "$KREL"

		say "rebuilding the default initramfs (mkinitcpio -P)"
		mkinitcpio -P >"$WORK/mk.log" 2>&1 \
			|| { tail -20 "$WORK/mk.log"; die "mkinitcpio failed; previous module kept at $CUR.prev-promote"; }

		say "verifying the rebuilt default image carries the promoted module"
		grub_image_module "$DEFAULT_IMG" "$WORK/def.ko.zst" \
			|| die "no module in the rebuilt default image"
		[[ "$(zstd -dcf "$WORK/def.ko.zst" | b2sum)" == "$(zstd -dcf "$WORK/new.ko.zst" | b2sum)" ]] \
			|| die "rebuilt default image does not carry the promoted module (see $WORK/mk.log); previous module at $CUR.prev-promote"

		grub_drop_entry "$NAME"; rm -f "$IMG"
		say "done — the default now boots what '/Test - $NAME' booted; that entry removed. Undo: sudo $0 add <name> $CUR.prev-promote, then promote it."
		grub_list
	}

	grub_drop() {   # grub_drop <name>
		need_root; NAME="${1:-}"; check_name "$NAME"
		grub_drop_entry "$NAME"; rm -f "$(grub_image_path "$NAME")"
		say "dropped '/Test - $NAME'"; grub_list
	}

	grub_list() {
		printf '\n  \033[1mBoot entries\033[0m  (kernel %s)\n\n' "$KREL"
		local tmp name img
		tmp="$(mktemp)"
		if [[ -f $DEFAULT_IMG ]] && grub_image_module "$DEFAULT_IMG" "$tmp" 2>/dev/null; then
			printf '  %-34s %s\n' "default (${PKGBASE})" "$(module_desc "$tmp")"
		fi
		while IFS= read -r name; do
			[[ -n $name ]] || continue
			img="$(grub_image_path "$name")"
			if [[ -f $img ]] && grub_image_module "$img" "$tmp" 2>/dev/null; then
				printf '  %-34s %s\n' "/Test - $name" "$(module_desc "$tmp")"
			else
				printf '  %-34s %s\n' "/Test - $name" "(image missing: $img)"
			fi
		done < <(grub_list_entries)
		rm -f "$tmp"
		# What actually loaded this boot, judged from the kernel log rather than
		# from the file on disk (the booted entry may not be the default).
		jl="$(journalctl -k -b 0 --no-pager 2>/dev/null || true)"
		if   [[ $jl == *"APPLE5K: stream["* ]]; then run="verbose-core"
		elif [[ $jl == *TILED_STITCH* ]];        then run="lean-core"
		else run="stock"; fi
		[[ $jl == *TILED_STITCH* ]] && run+="+stitch"
		[[ $jl == *"stream-disable latch"* ]] && run+="+latch-clear"
		printf '\n  running now: %s (tiled_stitch=%s)\n\n' "$run" "$(cat /sys/module/amdgpu/parameters/tiled_stitch 2>/dev/null || echo n/a)"
	}

	case "${1:-list}" in
	add)     grub_add "${2:-}" "${3:-}" ;;
	promote) grub_promote "${2:-}" ;;
	drop)    grub_drop "${2:-}" ;;
	list)    grub_list ;;
	*) die "usage: add <name> <module> | promote <name> | drop <name> | list" ;;
	esac
	exit 0
fi
imac_has_limine || {
	echo "This helper needs an Omarchy/Limine or Arch-family GRUB installation." >&2
	exit 1
}

case "${1:-list}" in

add)
	need_root; NAME="${2:-}"; SRC="${3:-}"
	check_name "$NAME"; [[ -f ${SRC} ]] || die "usage: sudo $0 add <name> <amdgpu.ko|amdgpu.ko.zst>"
	UKI="$(uki_path "$NAME")"
	[[ -d /usr/lib/modules/$KREL ]] || die "no module tree for $KREL"

	WORK="$(mktemp -d)"; trap 'rm -rf "$WORK"' EXIT
	MOD="$WORK/amdgpu.ko.zst"
	case "$SRC" in
		*.zst) cp -f "$SRC" "$MOD" ;;
		*.ko)  say "compressing module"; zstd -q -19 -T0 -o "$MOD" "$SRC" ;;
		*)     die "module must end in .ko or .ko.zst" ;;
	esac

	vm="$(modinfo -F vermagic "$MOD" 2>/dev/null | awk '{print $1}')"
	[[ $vm == "$KREL" ]] || die "module vermagic '$vm' != running kernel '$KREL' — it would fail to load"

	say "staging a private copy of the $KREL module tree"
	ALT="$WORK/root"; mkdir -p "$ALT/usr/lib/modules"; ln -s usr/lib "$ALT/lib"
	rsync -a --exclude build --exclude '*.stock-backup' --exclude '*.prev-*' \
		"/usr/lib/modules/$KREL" "$ALT/usr/lib/modules/"
	install -m644 "$MOD" "$ALT/usr/lib/modules/$KREL/$MODREL"
	depmod -b "$ALT" "$KREL"

	CMDLINE="${IMAC_CMDLINE:-$(grep -m1 '^  cmdline:' "$CONF" | sed 's/^  cmdline: //')}"
	[[ -n $CMDLINE ]] || die "could not read a cmdline from $CONF (set IMAC_CMDLINE)"
	printf '%s\n' "$CMDLINE" > "$WORK/cmdline"

	say "building UKI $(basename "$UKI") with mkinitcpio --moduleroot"
	mkinitcpio --kernel "$KREL" --moduleroot "$ALT" --cmdline "$WORK/cmdline" --uki "$WORK/uki.efi" >"$WORK/mkinitcpio.log" 2>&1 \
		|| { tail -20 "$WORK/mkinitcpio.log"; die "mkinitcpio failed"; }

	say "verifying the UKI carries exactly the module you gave"
	uki_module "$WORK/uki.efi" "$WORK/inside.ko.zst" || die "no amdgpu module found inside the built UKI"
	[[ "$(zstd -dcf "$WORK/inside.ko.zst" | b2sum)" == "$(zstd -dcf "$MOD" | b2sum)" ]] \
		|| die "module inside the UKI differs from the one given — refusing to install"
	emb="$(objcopy -O binary --only-section=.cmdline "$WORK/uki.efi" /dev/stdout 2>/dev/null | tr -d '\0' | sed 's/[[:space:]]*$//')"
	[[ $emb == "$CMDLINE" ]] || die "embedded cmdline mismatch"

	mkdir -p "$UKIDIR"; install -m700 "$WORK/uki.efi" "$UKI"; sync
	remove_entry "$NAME"; add_entry "$NAME" "$UKI" "$CMDLINE" "$(basename "$SRC")"
	sync_conf
	say "done — '$(marker "$NAME")' boots $(module_desc "$MOD"); default entry untouched"
	"$0" list
	;;

promote)
	need_root; NAME="${2:-}"; check_name "$NAME"
	UKI="$(uki_path "$NAME")"; [[ -f $UKI ]] || die "no UKI for '$NAME' at $UKI"
	grep -qF "$(marker "$NAME")" "$CONF" || die "no entry '$(marker "$NAME")' in $CONF"
	WORK="$(mktemp -d)"; trap 'rm -rf "$WORK"' EXIT
	CUR="/usr/lib/modules/$KREL/$MODREL"

	say "extracting the module that '$(marker "$NAME")' boots"
	uki_module "$UKI" "$WORK/new.ko.zst" || die "no amdgpu module inside $UKI"
	vm="$(modinfo -F vermagic "$WORK/new.ko.zst" 2>/dev/null | awk '{print $1}')"
	[[ $vm == "$KREL" ]] || die "module vermagic '$vm' != running kernel '$KREL'"

	say "keeping the current default module beside it as amdgpu.ko.zst.prev-promote"
	cp -f "$CUR" "$CUR.prev-promote"
	install -m644 "$WORK/new.ko.zst" "$CUR"
	depmod "$KREL"

	say "rebuilding the default UKI the normal way (limine-mkinitcpio)"
	if command -v limine-mkinitcpio >/dev/null; then
		limine-mkinitcpio >"$WORK/mk.log" 2>&1 || { tail -20 "$WORK/mk.log"; die "limine-mkinitcpio failed; previous module kept at $CUR.prev-promote"; }
	else
		mkinitcpio -P >"$WORK/mk.log" 2>&1 || die "mkinitcpio failed; previous module kept at $CUR.prev-promote"
	fi

	say "verifying the rebuilt default UKI carries the promoted module"
	uki_module "$UKIDIR/omarchy_linux.efi" "$WORK/def.ko.zst" || die "no module in the rebuilt default UKI"
	[[ "$(zstd -dcf "$WORK/def.ko.zst" | b2sum)" == "$(zstd -dcf "$WORK/new.ko.zst" | b2sum)" ]] \
		|| die "rebuilt default UKI does not carry the promoted module (see $WORK/mk.log); previous module at $CUR.prev-promote"

	remove_entry "$NAME"; rm -f "$UKI"
	repin_orphans
	sync_conf
	say "done — the default now boots what '$(marker "$NAME")' booted; that entry removed. Undo: sudo $0 add <name> $CUR.prev-promote, then promote it."
	"$0" list
	;;

drop)
	need_root; NAME="${2:-}"; check_name "$NAME"
	remove_entry "$NAME"; rm -f "$(uki_path "$NAME")"; sync_conf
	say "dropped '$(marker "$NAME")'"; "$0" list
	;;

list)
	printf '\n  \033[1mBoot entries\033[0m  (kernel %s)\n\n' "$KREL"
	tmp="$(mktemp)"
	if uki_module "$UKIDIR/omarchy_linux.efi" "$tmp" 2>/dev/null; then
		printf '  %-34s %s\n' "default (Omarchy/linux)" "$(module_desc "$tmp")"
	fi
	while IFS= read -r line; do
		name="${line#/Test - }"; name="${name%% (*}"
		efi="$(sed -n "/^\/Test - ${name//\//\\/}/,/^cmdline:/{s/^path: boot():\(.*\)#.*/\1/p}" "$CONF" | head -1)"
		if [[ -n $efi && -f "$ESP$efi" ]] && uki_module "$ESP$efi" "$tmp" 2>/dev/null; then
			printf '  %-34s %s\n' "/Test - $name" "$(module_desc "$tmp")"
		else
			printf '  %-34s %s\n' "/Test - $name" "(UKI missing: $efi)"
		fi
	done < <(grep '^/Test - ' "$CONF" 2>/dev/null || true)
	rm -f "$tmp"
	# What actually loaded this boot, judged from the kernel log rather than
	# from the file on disk (the booted entry may not be the default).
	jl="$(journalctl -k -b 0 --no-pager 2>/dev/null || true)"
	if   [[ $jl == *"APPLE5K: stream["* ]]; then run="verbose-core"
	elif [[ $jl == *TILED_STITCH* ]];        then run="lean-core"
	else run="stock"; fi
	[[ $jl == *TILED_STITCH* ]] && run+="+stitch"
	[[ $jl == *"stream-disable latch"* ]] && run+="+latch-clear"
	printf '\n  running now: %s (tiled_stitch=%s)\n\n' "$run" "$(cat /sys/module/amdgpu/parameters/tiled_stitch 2>/dev/null || echo n/a)"
	;;
*) die "usage: add <name> <module> | promote <name> | drop <name> | list" ;;
esac
