#!/usr/bin/env bash
# imac-igpu-check -- read-only status report for the headless HD 630, the
# state `imac-patcher --apply macos` puts the machine in.
# Run as the desktop user; `sudo imac-igpu-check` additionally shows i915 params,
# DMC/DC-state counters and runtime-PM detail from debugfs. Changes nothing.
set -u
IGPU=/sys/bus/pci/devices/0000:00:02.0
AMD=/sys/bus/pci/devices/0000:01:00.0
hdr() { printf '\n== %s\n' "$*"; }
# readlink -f on a device with no driver returns the path itself, whose
# basename is the word "driver"; test the symlink instead.
drv() { if [[ -L $1/driver ]]; then basename "$(readlink -f "$1/driver")"; else echo none; fi; }

hdr "PCI / drivers"
if [[ -e $IGPU ]]; then
	echo "00:02.0 present, driver=$(drv $IGPU), boot_vga=$(cat $IGPU/boot_vga 2>/dev/null), runtime=$(cat $IGPU/power/runtime_status 2>/dev/null) ($(cat $IGPU/power/control 2>/dev/null))"
else
	echo "00:02.0 absent (iGPU hidden: this boot did not go through set_os). Nothing else to check."
fi
echo "01:00.0 driver=$(drv $AMD), boot_vga=$(cat $AMD/boot_vga 2>/dev/null)  <- must stay 1"

hdr "/dev/dri"
ls -l /dev/dri /dev/dri/by-path 2>/dev/null
for n in amd-card amd-render intel-card intel-render; do
	printf '%-14s -> %s\n' "$n" "$(readlink /dev/dri/$n 2>/dev/null || echo MISSING)"
done

hdr "Connectors per card (the Intel card must have none)"
for c in /sys/class/drm/card[0-9]; do
	d=$(drv "$c/device")
	printf '%s (%s): %s\n' "${c##*/}" "$d" "$(cd /sys/class/drm && ls -d "${c##*/}"-* 2>/dev/null | tr '\n' ' ')"
done

hdr "Compositor GPU pin"
# Not /proc/PID/environ: that is the environment the process was started with,
# and Hyprland applies its config `env` with setenv(), which never shows up
# there. What the compositor actually opened is the evidence that counts.
hp=$(pgrep -x Hyprland | head -1)
if [[ -z $hp ]]; then
	echo "Hyprland is not running"
else
	held=$(ls -l "/proc/$hp/fd" 2>/dev/null | grep -o '/dev/dri/[a-zA-Z0-9]*' | sort -u | tr '\n' ' ')
	echo "Hyprland has open: ${held:-<file descriptors unreadable>}"
	intel_nodes="$(readlink -f /dev/dri/intel-card 2>/dev/null) $(readlink -f /dev/dri/intel-render 2>/dev/null)"
	for node in $intel_nodes; do
		[[ -n $node && " $held " == *" $node "* ]] && echo "  !! the compositor opened the Intel GPU: the AQ_DRM_DEVICES pin is NOT in effect"
	done
	[[ -n $held ]] && [[ " $held " != *"$(readlink -f /dev/dri/intel-card 2>/dev/null)"* ]] \
		&& echo "  the Radeon only, so the pin is in effect"
	if grep -q 'hypr.imac-gpu' "${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hyprland.lua" 2>/dev/null; then
		echo "hyprland.lua requires hypr.imac-gpu"
	else
		echo "hyprland.lua does NOT require hypr.imac-gpu"
	fi
fi
if [[ -e /dev/dri/intel-card ]] && command -v fuser >/dev/null; then
	echo "every process holding the Intel card/render node:"
	fuser -v /dev/dri/intel-card /dev/dri/intel-render 2>&1 | sed 's/^/  /'
fi

hdr "Backlight (the other half of macOS mode)"
for b in /sys/class/backlight/*; do
	[[ -d $b ]] || continue
	max=$(cat "$b/max_brightness" 2>/dev/null)
	printf '%s: brightness=%s max=%s type=%s\n' "${b##*/}" \
		"$(cat "$b/brightness" 2>/dev/null)" "$max" "$(cat "$b/type" 2>/dev/null)"
	case $max in
		96) echo "  full range: the upgraded ACPI table is live (levels 4..100, 65500 of 65535)" ;;
		79) echo "  firmware range: levels 1..80, so 100% is 52400 of 65535 -- about 80% of the panel" ;;
		*)  echo "  unrecognised range" ;;
	esac
done
journalctl -k -b --no-pager 2>/dev/null | grep -i "Table Upgrade" | sed 's/^/  /' | tail -3
SMBUS=/sys/bus/pci/devices/0000:00:1f.4
[[ -e $SMBUS ]] && echo "SMBus 00:1f.4: enable=$(cat $SMBUS/enable 2>/dev/null) driver=$(drv $SMBUS) <- must be enabled; the firmware drives the backlight over it"
NVRAM_VAR=/sys/firmware/efi/efivars/backlight-level-7c436110-ab2a-4bbb-a880-fe41995c9f82
if [[ -r $NVRAM_VAR ]]; then
	echo "NVRAM backlight-level: $(od -An -tu2 -j4 -N2 "$NVRAM_VAR" | tr -d ' ') of 65535 (what the firmware lights the panel at from power-on)"
else
	echo "NVRAM backlight-level: unreadable"
fi
echo "save-at-shutdown unit: $(systemctl is-enabled imac-backlight-nvram.service 2>&1)"
echo "whether it really dims can only be seen by eye:"
echo "  sudo brightnessctl -d acpi_video0 set 40%   # then: set 100%"

hdr "Kernel log (i915, DMC, GuC/HuC, VBT, HDA binding)"
journalctl -k -b --no-pager 2>/dev/null | grep -E -i 'i915|kbl_|dmc|guc|huc|vbt|snd_hda_intel|hdaudio' | grep -v -i 'amdgpu' | tail -40

hdr "Taint"
t=$(cat /proc/sys/kernel/tainted); echo "tainted=$t, U-bit(6, unsafe module param e.g. vbt_firmware)=$(( (t >> 6) & 1 ))"

hdr "ALSA / PipeWire"
cat /proc/asound/cards
for c in /proc/asound/card*/codec#*; do echo "$c: $(head -1 "$c")"; done
command -v wpctl >/dev/null && wpctl status 2>/dev/null | sed -n '/Audio/,/Video/p' | grep -E 'Sinks|Sources|\*|[0-9]+\.' | head -20

hdr "VA-API"
if command -v vainfo >/dev/null; then
	for n in intel-render amd-render; do
		[[ -e /dev/dri/$n ]] || continue
		echo "--- $n"
		vainfo --display drm --device /dev/dri/$n 2>&1 | grep -E 'Driver version|VAProfile(H264|HEVC|VP9).*(EncSlice|VLD)' | head -14
	done
else
	echo "vainfo missing (libva-utils)"
fi

hdr "GT idle"
for c in /sys/class/drm/card[0-9]; do
	[[ -r $c/gt/gt0/rc6_residency_ms ]] && echo "${c##*/} rc6_residency_ms=$(cat $c/gt/gt0/rc6_residency_ms) (should climb ~1000/s at idle)"
done

if [[ $EUID -eq 0 ]]; then
	hdr "root-only: i915 params, DMC, runtime PM"
	for p in disable_display vbt_firmware enable_dc enable_guc; do
		f=/sys/module/i915/parameters/$p; [[ -r $f ]] && echo "i915.$p=$(cat $f)"
	done
	echo "snd_hda_core.gpu_bind=$(cat /sys/module/snd_hda_core/parameters/gpu_bind 2>/dev/null)"
	echo "snd_hda_intel.power_save=$(cat /sys/module/snd_hda_intel/parameters/power_save 2>/dev/null)"
	for d in /sys/kernel/debug/dri/*/; do
		[[ -r $d/name ]] && grep -q i915 "$d/name" || continue
		echo "--- $d"
		cat "$d/i915_dmc_info" 2>/dev/null
		grep -E 'Runtime power status|GPU idle' "$d/i915_runtime_pm_status" 2>/dev/null
		cat "$d/gt0/uc/huc_info" 2>/dev/null | head -5
	done
fi
