#!/usr/bin/env bash
#
# imac-test-entry — boot a risky amdgpu build from its own boot entry, so the
# default entry always stays on something known to work.
#
# The problem this solves: installing a patched amdgpu module overwrites the
# live one and rebuilds the UKI in place. If the new module is bad you have no
# "boot the old one" option — only a full subvolume rollback or a USB stick.
# Snapper snapshots don't fill the gap either: they're read-only, so they give
# you a rescue shell rather than a working desktop.
#
# Instead:
#
#   default entry  ->  omarchy_linux.efi          (known-good module)
#   test entry     ->  omarchy_linux-5ktest.efi   (the build under test)
#
# The module is baked into the initramfs (MODULES=(amdgpu) + the kms hook), so
# whichever entry you pick decides which module loads. If the test entry
# misbehaves, reboot and take the default — nothing to restore.
#
# The test entry is appended to limine.conf by hand, and limine.conf is
# auto-generated, so a regeneration may drop it. Observed so far: it survives
# limine-snapper-sync (verified twice, 2026-09-05); behaviour across a full
# limine-mkinitcpio run is untested. Either way the failure direction is the
# safe one -- what you lose is the test, what you keep is a known-good default.
#
# On Arch-family GRUB systems the same two slots are a cloned grub.cfg entry in
# /etc/grub.d/40_custom plus a separate initramfs image
# (/boot/initramfs-<pkgbase>-imac-5ktest.img). The default entry keeps booting
# the stock image, and grub-mkconfig carries the test block across regens.
#
#   imac-test-entry stage <known-good-amdgpu.ko.zst>
#       Current UKI becomes the test entry. The module you name is installed as
#       the default and the default UKI is rebuilt around it.
#
#   imac-test-entry promote      Test build becomes the permanent default.
#   imac-test-entry drop         Discard the test build; keep the default.
#   imac-test-entry status       What each entry currently boots.
#
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
source "${SCRIPT_DIR}/lib/platform.sh"
if imac_is_fedora; then
    echo "This helper is for Omarchy/Limine and Arch-family GRUB, not Fedora." >&2
    exit 1
fi


KREL="$(uname -r)"
MODDIR="/usr/lib/modules/${KREL}/kernel/drivers/gpu/drm/amd/amdgpu"
MODULE="${MODDIR}/amdgpu.ko.zst"
ESP=/boot
# The default UKI is named after the kernel package base (linux, linux-t2, ...).
KPKG="$(cat "/usr/lib/modules/${KREL}/pkgbase" 2>/dev/null || echo linux)"
UKI="${ESP}/EFI/Linux/omarchy_${KPKG}.efi"
TESTUKI="${ESP}/EFI/Linux/omarchy_linux-5ktest.efi"
CONF="${ESP}/limine.conf"
MARKER="/Test - 5K boot fixes"

say() { printf '\033[1;33m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;31m!!\033[0m %s\n' "$*" >&2; }
die() { printf '\033[1;31mERROR:\033[0m %s\n' "$*" >&2; exit 1; }

need_root() { [[ $EUID -eq 0 ]] || die "run with sudo: sudo $0 $*"; }

# There is exactly ONE limine.conf: /boot/limine.conf. Limine >= 10.3.0 loads
# the first config in its search order, so copies at EFI/limine/ or EFI/BOOT/
# override it and go stale -- `limine-install` flags them as conflicts. An
# earlier version of this script created them; now it removes them.
sync_conf() {
	local f
	for f in "${ESP}/EFI/limine/limine.conf" "${ESP}/EFI/BOOT/limine.conf" \
		"${ESP}/boot/limine/limine.conf" "${ESP}/limine/limine.conf"; do
		[[ -f $f ]] && rm -f "$f"
	done
	sync
}

# Limine pins each image by BLAKE2B-512 and this config sets
# hash_mismatch_panic: yes, so an entry whose hash drifts refuses to boot.
uki_hash() { b2sum "$1" | cut -d' ' -f1; }

has_test_entry() { grep -qF "$MARKER" "$CONF" 2>/dev/null; }

remove_test_entry() {
	[[ -f $CONF ]] || return 0
	# Drop ONLY this entry's block: from the marker line up to (not including)
	# the next top-level entry, or end of file. Another tool (imac-alt-entry)
	# keeps its own hand-added entry in the same file; deleting "marker to end
	# of file" would take that one with it whenever ours sits above it.
	python3 - "$CONF" "$MARKER" <<'PY2'
import sys
p, marker = sys.argv[1], sys.argv[2]
lines = open(p).read().split("\n")
out, skip = [], False
for ln in lines:
    if ln.startswith(marker):
        skip = True; continue
    if skip and ln.startswith("/"):
        skip = False
    if not skip:
        out.append(ln)
text = "\n".join(out).rstrip("\n") + "\n"
open(p, "w").write(text)
PY2
	sync_conf
}

append_test_entry() {
	local hash cmdline
	hash="$(uki_hash "$TESTUKI")"
	cmdline="$(grep -m1 '^  cmdline:' "$CONF" | sed 's/^  cmdline: //')"
	[[ -n $cmdline ]] || die "could not read a cmdline from $CONF"

	cat >> "$CONF" <<EOF

${MARKER} (remove after confirming)
### Added by imac-test-entry, not by limine-entry-tool. A config regeneration
### may drop it; that leaves the known-good default, which is the safe outcome.
protocol: efi
path: boot():/EFI/Linux/$(basename "$TESTUKI")#${hash}
cmdline: ${cmdline}
EOF
	sync_conf
}

rebuild_default_uki() {
	say "rebuilding the default UKI around the installed module"
	if command -v limine-mkinitcpio >/dev/null; then limine-mkinitcpio >/dev/null; else mkinitcpio -P >/dev/null; fi

	# On a stock ESP \EFI\BOOT\BOOTX64.EFI is the Limine binary and must not be
	# touched. Only machines still running the old "UKI over the fallback"
	# bypass need it refreshed, or that path boots a stale initramfs.
	#
	# NB: `objcopy --only-section=X` exits 0 even when section X is absent -- it
	# writes nothing. Testing its exit status calls every PE binary a UKI, and
	# this line then overwrites Limine with a 74 MB kernel image.
	local fb="${ESP}/EFI/BOOT/BOOTX64.EFI" probe
	if [[ -f $fb ]]; then
		probe="$(mktemp)"
		objcopy -O binary --only-section=.cmdline "$fb" "$probe" 2>/dev/null || true
		[[ -s $probe ]] && cp -f "$UKI" "$fb" 2>/dev/null
		rm -f "$probe"
	fi
	sync_conf
}

# Pull amdgpu.ko.zst back out of a UKI's initramfs. This is what makes promote
# self-contained: the build under test is recovered from the image that was
# actually booted, not from a build tree that may have moved on since.
extract_module() {   # extract_module <uki> <dest>
	local img
	img="$(mktemp)"
	objcopy -O binary --only-section=.initrd "$1" "$img" 2>/dev/null \
		|| { rm -f "$img"; die "could not read an initramfs out of $1"; }
	bsdtar -xOf "$img" "usr/lib/modules/*/kernel/drivers/gpu/drm/amd/amdgpu/amdgpu.ko.zst" > "$2" 2>/dev/null \
		|| { rm -f "$img"; die "no amdgpu module inside $1"; }
	rm -f "$img"
	[[ -s $2 ]] || die "extracted an empty module from $1"
}

# Report which fixes a module carries, so status/promote can say what is what
# rather than just printing file sizes.
describe_module() {  # describe_module <path-to-.ko.zst>
	local ko syms marks=()
	ko="$(mktemp --suffix=.ko)"   # modinfo only reads files named *.ko
	zstd -dcf "$1" > "$ko" 2>/dev/null || { rm -f "$ko"; echo "unreadable"; return; }
	# NB: capture then match. "strings ... | grep -q" is unsafe under
	# `set -o pipefail`: grep -q exits on the first match, strings takes
	# SIGPIPE, and pipefail then reports the pipeline as failed even though
	# the match succeeded — so every module reads as "stock".
	syms="$(strings "$ko" 2>/dev/null || true)"
	# Two builds can carry the same fix strings and differ only in code, so
	# always show the module's srcversion as well. modinfo needs the
	# decompressed module: a temp file without a .ko.zst suffix is opaque to it.
	local sv; sv="$(modinfo -F srcversion "$ko" 2>/dev/null || echo '?')"
	rm -f "$ko"
	[[ $syms == *tiled_stitch* ]]                 && marks+=("5K stitch")
	[[ $syms == *"stream-disable latch"* ]]       && marks+=("latch clear")
	[[ $syms == *"forcing initial modeset"* ]]    && marks+=("early modeset")
	[[ $syms == *"link-health"* ]]                && marks+=("link health")
	((${#marks[@]})) && (IFS=', '; echo "${marks[*]} [${sv:0:8}]") || echo "stock [${sv:0:8}]"
}

# ── GRUB backend (Arch family) ─────────────────────────────────────────────
# Same two slots, different mechanics: the test build lives in its own
# initramfs image and a cloned grub.cfg entry in /etc/grub.d/40_custom; the
# default entry keeps booting the stock image, so a bad test build is escaped
# by simply rebooting into the default.
if imac_is_arch_grub; then
	source "${SCRIPT_DIR}/lib/grub.sh"
	PKGBASE="$(imac_kernel_pkgbase "$KREL")"
	DEFAULT_IMG="$GRUB_BOOT_DIR/initramfs-${PKGBASE}.img"
	TESTNAME=5ktest
	TESTIMG="$(grub_image_path "$TESTNAME")"

	grub_stage() {   # $1 = known-good amdgpu.ko[.zst] to make the default
		need_root "$@"
		GOOD="${1:-}"
		[[ -f ${GOOD:-} ]] || die "usage: sudo $0 stage <known-good-amdgpu.ko.zst>
	The currently installed module is treated as the build under test; the
	module you name here becomes the default. Typical source: the .prev-5k or
	.stock-backup kept beside the installed module."
		grub_require_layout || die "unsupported or stale GRUB boot layout"
		[[ -f $MODULE ]] || die "no installed module at $MODULE"
		command -v mkinitcpio >/dev/null || die "mkinitcpio not found"

		WORK="$(mktemp -d)"; trap 'rm -rf "$WORK"' EXIT
		grub_prepare_module "$GOOD" "$WORK/good.ko.zst" || die "invalid known-good module"
		say "building the test initramfs around the installed (under-test) module"
		grub_build_image "$WORK/test.img" >"$WORK/mk.log" 2>&1 \
			|| { tail -20 "$WORK/mk.log"; die "mkinitcpio failed"; }
		grub_image_module "$WORK/test.img" "$WORK/test.ko.zst" \
			|| die "no amdgpu module inside the test image"
		[[ $(zstd -dcf "$WORK/test.ko.zst" | b2sum) == $(zstd -dcf "$MODULE" | b2sum) ]] \
			|| die "test image does not carry the installed module"
		install -m644 "$WORK/test.img" "$TESTIMG"

		say "installing the known-good module as the default"
		cp -f "$MODULE" "$MODULE.prev-stage"
		cp -f "$WORK/good.ko.zst" "$MODULE"
		depmod "$KREL"
		mkinitcpio -P >"$WORK/mk-default.log" 2>&1 \
			|| { tail -20 "$WORK/mk-default.log"; die "mkinitcpio failed"; }

		grub_image_module "$DEFAULT_IMG" "$WORK/default.ko.zst" || die "no module in the rebuilt default image"
		[[ $(zstd -dcf "$WORK/default.ko.zst" | b2sum) == $(zstd -dcf "$WORK/good.ko.zst" | b2sum) ]] \
			|| die "rebuilt default image does not carry the known-good module; previous module at $MODULE.prev-stage"

		grub_clone_entry "$TESTNAME" "$TESTIMG" || die "could not add the GRUB test entry"
		say "done — default boots known-good, '/Test - 5ktest' boots the build under test"
		grub_status
	}

	grub_promote() {
		need_root
		grub_require_layout || die "unsupported or stale GRUB boot layout"
		grub_entry_exists "$TESTNAME" || die "no test entry present — nothing to promote"
		[[ -f $TESTIMG ]] || die "no test image at $TESTIMG"
		WORK="$(mktemp -d)"; trap 'rm -rf "$WORK"' EXIT

		say "promoting the test build to the permanent default"
		grub_image_module "$TESTIMG" "$WORK/new.ko.zst" || die "no amdgpu module inside $TESTIMG"
		vm="$(modinfo -F vermagic "$WORK/new.ko.zst" 2>/dev/null | awk '{print $1}')"
		[[ $vm == "$KREL" ]] || die "module vermagic '$vm' != running kernel '$KREL'"
		cp -f "$MODULE" "$MODULE.prev-promote"
		cp -f "$WORK/new.ko.zst" "$MODULE"
		depmod "$KREL"
		mkinitcpio -P >"$WORK/mk.log" 2>&1 \
			|| { tail -20 "$WORK/mk.log"; die "mkinitcpio failed"; }

		say "verifying the rebuilt default image carries the promoted module"
		grub_image_module "$DEFAULT_IMG" "$WORK/def.ko.zst" \
			|| die "no module in the rebuilt default image"
		[[ $(zstd -dcf "$WORK/def.ko.zst" | b2sum) == $(zstd -dcf "$WORK/new.ko.zst" | b2sum) ]] \
			|| die "rebuilt default image does not carry the promoted module (see $WORK/mk.log)"

		grub_drop_entry "$TESTNAME"
		rm -f "$TESTIMG"
		say "done — the tested build is now the default; test entry removed"
		grub_status
	}

	grub_drop() {
		need_root
		say "discarding the test build"
		grub_drop_entry "$TESTNAME"
		rm -f "$TESTIMG"
		say "done — default is unchanged and still known-good"
		grub_status
	}

	grub_status() {
		printf '\n  \033[1mBoot entries\033[0m  (kernel %s)\n\n' "$KREL"
		local tmp
		tmp="$(mktemp)"
		if [[ -f $DEFAULT_IMG ]] && grub_image_module "$DEFAULT_IMG" "$tmp" 2>/dev/null; then
			printf '  %-26s %s\n' "default (${PKGBASE})" "$(describe_module "$tmp")"
		fi
		if grub_entry_exists "$TESTNAME" && [[ -f $TESTIMG ]]; then
			: > "$tmp"
			grub_image_module "$TESTIMG" "$tmp" 2>/dev/null || true
			printf '  %-26s %s\n' "test entry (GRUB)" "$([[ -s $tmp ]] && describe_module "$tmp" || echo '?')"
		else
			printf '  %-26s %s\n' "test entry (GRUB)" "none"
		fi
		rm -f "$tmp"

		printf '\n  \033[1mRunning now\033[0m\n\n'
		klog="$(journalctl -k -b 0 --no-pager 2>/dev/null || true)"
		printf '  %-26s %s\n' "loaded amdgpu" \
			"$(grep -qi 'panel latch teardown\|forcing initial modeset' <<<"$klog" \
				&& echo 'test build (fix log lines present)' || echo 'no fix log lines this boot')"
		if grep -q 'APPLE5K: link-health build=' <<<"$klog"; then
			verdict="$(grep -o 'APPLE5K: link-health \(PASS\|FAIL\|disarmed\).*' <<<"$klog" | tail -1)"
			printf '  %-26s %s\n' "post-commit link health" "${verdict:-armed, no verdict yet}"
			printf '  %-26s %s\n' "" "journalctl -k -b 0 | grep 'APPLE5K: link-health'"
		fi
		printf '\n'
	}

	case "${1:-status}" in
	stage)   grub_stage "${2:-}" ;;
	promote) grub_promote ;;
	drop)    grub_drop ;;
	status)  grub_status ;;
	*) die "unknown command '${1}'. Try: stage <module> | promote | drop | status" ;;
	esac
	exit 0
fi
imac_has_limine || {
	echo "This helper needs an Omarchy/Limine or Arch-family GRUB installation." >&2
	exit 1
}

case "${1:-status}" in

stage)
	need_root "$@"
	GOOD="${2:-}"
	[[ -f ${GOOD:-} ]] || die "usage: sudo $0 stage <known-good-amdgpu.ko.zst>
The current UKI is treated as the build under test; the module you name here
becomes the default. Typical source: the .prev-5k or .stock-backup kept beside
the installed module."
	[[ -f $UKI ]] || die "no UKI at $UKI"

	say "staging the current UKI as the test entry"
	cp -f "$UKI" "$TESTUKI"

	say "installing the known-good module as the default"
	cp -f "$GOOD" "$MODULE"
	depmod "$KREL"

	rebuild_default_uki
	remove_test_entry
	append_test_entry

	say "done — default boots known-good, '$MARKER' boots the build under test"
	"$0" status
	;;

promote)
	need_root "$@"
	has_test_entry || die "no test entry present — nothing to promote"
	[[ -f $TESTUKI ]] || die "no test UKI at $TESTUKI"

	say "promoting the test build to the permanent default"
	tmp="$(mktemp)"
	extract_module "$TESTUKI" "$tmp"
	cp -f "$tmp" "$MODULE"
	rm -f "$tmp"
	depmod "$KREL"

	rebuild_default_uki
	remove_test_entry
	rm -f "$TESTUKI"

	say "done — the tested build is now the default; test entry removed"
	"$0" status
	;;

drop)
	need_root "$@"
	say "discarding the test build"
	remove_test_entry
	rm -f "$TESTUKI"
	say "done — default is unchanged and still known-good"
	"$0" status
	;;

status)
	printf '\n  \033[1mBoot entries\033[0m  (kernel %s)\n\n' "$KREL"

	if [[ -f $UKI ]]; then
		tmp="$(mktemp)"; extract_module "$UKI" "$tmp" 2>/dev/null || true
		printf '  %-26s %s\n' "default (Omarchy/linux)" "$([[ -s $tmp ]] && describe_module "$tmp" || echo '?')"
		rm -f "$tmp"
	fi

	if has_test_entry && [[ -f $TESTUKI ]]; then
		tmp="$(mktemp)"; extract_module "$TESTUKI" "$tmp" 2>/dev/null || true
		printf '  %-26s %s\n' "test entry" "$([[ -s $tmp ]] && describe_module "$tmp" || echo '?')"
		rm -f "$tmp"
	else
		printf '  %-26s %s\n' "test entry" "none"
	fi

	printf '\n  \033[1mRunning now\033[0m\n\n'
	klog="$(journalctl -k -b 0 --no-pager 2>/dev/null || true)"
	printf '  %-26s %s\n' "loaded amdgpu" \
		"$(grep -qi 'panel latch teardown\|forcing initial modeset' <<<"$klog" \
			&& echo 'test build (fix log lines present)' || echo 'no fix log lines this boot')"

	# The link-health build announces itself at DM init, before any panel is
	# detected, so its absence means that module did not load -- not that the
	# panel went undetected.
	if grep -q 'APPLE5K: link-health build=' <<<"$klog"; then
		verdict="$(grep -o 'APPLE5K: link-health \(PASS\|FAIL\|disarmed\).*' <<<"$klog" | tail -1)"
		printf '  %-26s %s\n' "post-commit link health" "${verdict:-armed, no verdict yet}"
		printf '  %-26s %s\n' "" "journalctl -k -b 0 | grep 'APPLE5K: link-health'"
	fi
	printf '\n'
	;;

*)
	die "unknown command '${1}'. Try: stage <module> | promote | drop | status"
	;;
esac
