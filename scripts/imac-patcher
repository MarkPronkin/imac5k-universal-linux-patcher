#!/usr/bin/env bash
#
# imac-patcher — patch manager for Apple Retina 5K iMacs under Linux.
#
# Every fix is a module implementing the same contract:
#   mod_<id>_title / _tier / _desc   metadata
#   mod_<id>_detect                  -> applied | not-applied | partial | n/a
#   mod_<id>_apply                   install it
#   mod_<id>_remove                  undo it
#
# Tiers:
#   safe   included by the "safe" batch selector
#   boot   touches boot config or GPU driver    (flagged, prints recovery first)
#
# Usage:
#   imac-patcher                 interactive
#   imac-patcher --status        print status of every module
#   imac-patcher --apply  <id..> apply named modules (or "safe" for all safe ones)
#   imac-patcher --remove <id..> remove named modules
#   imac-patcher --version       print the installed release version
#   imac-patcher upgrade         install the newest release of this tool
#   imac-patcher --help          show commands and module IDs
#
set -uo pipefail
export PATH="/usr/sbin:/sbin:$PATH"

# These are needed to locate the release and reach the full dependency gate.
# Report them using Bash builtins, before an absent readlink/cat can turn into
# an empty path or an "unknown" model with the original error hidden.
bootstrap_missing=()
for bootstrap_tool in readlink dirname cat uname; do
    command -v "$bootstrap_tool" >/dev/null || bootstrap_missing+=("$bootstrap_tool")
done
if ((${#bootstrap_missing[@]})); then
    printf 'Missing launcher tools: %s\nInstall coreutils with your distribution package manager, then re-run imac-patcher.\n' \
        "${bootstrap_missing[*]}" >&2
    exit 1
fi

# readlink -f, not plain dirname: a release install is reached through a
# ~/.local/bin symlink, and the modules load their libs, patches and configs
# relative to where the real script lives.
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
REPO_DIR="$(dirname "$SCRIPT_DIR")"
source "${SCRIPT_DIR}/lib/platform.sh"
INSTALLER_5K="${SCRIPT_DIR}/patch-imac5k-amdgpu.sh"
LOGDIR="${HOME}/.local/state/imac-patcher"
CACHE="${HOME}/.cache/imac-patcher"
KREL="$(uname -r)"
# Fedora release strings contain more dots after the first two components.
KSERIES="${KREL#*.}"
KSERIES="${KREL%%.*}.${KSERIES%%.*}"
SUPPORTED_5K_SERIES="7.1 7.2"
LIMINE_DEFAULT=/etc/default/limine
LIMINE_DROPIN_DIR=/etc/limine-entry-tool.d
STITCH_DROPIN="${LIMINE_DROPIN_DIR}/imac5k-stitch.conf"
FALLBACK_4K_DROPIN="${LIMINE_DROPIN_DIR}/imac4k-fallback.conf"
VIDEO_4K='video=eDP-1:3840x2160@60e'
MONITORS_LUA="${HOME}/.config/hypr/monitors.lua"
SLEEP_TARGETS=(suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target)
# Retired "sleep with idle=poll" variant: it hung the same way, so the suspend
# module now only blocks sleep and cleans these leftovers up.
NO_CSTATES_PARAM='idle=poll'
NO_CSTATES_DROPIN="${LIMINE_DROPIN_DIR}/imac5k-no-cstates.conf"
MODULES=(audio eq color suspend boot 5k)

HAVE_GUM=0; command -v gum >/dev/null && HAVE_GUM=1
say()  { printf '\033[1;33m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;31m!!\033[0m %s\n' "$*"; }
hdr()  { if ((HAVE_GUM)); then gum style --border rounded --padding "0 2" --bold "$*"; else printf '\n== %s ==\n' "$*"; fi; }
# gum needs an interactive input and an output terminal. Print the plain prompt
# explicitly: Bash's read -p silently omits it when stdin is a pipe.
confirm(){
    local a
    if ((HAVE_GUM)) && [[ -t 0 && -t 2 ]]; then gum confirm "$1"; return; fi
    printf '%s [y/N] ' "$1" >&2
    IFS= read -r a || { printf '\nNo confirmation received.\n' >&2; return 1; }
    [[ $a == [yY]* ]]
}

# ── command-line arguments ────────────────────────────────────────────────
usage() {
    cat <<'USAGE'
Usage: imac-patcher [--force] [COMMAND]

  (no command)          open the interactive menu
  --status              show the state of every module
  --apply <id...|safe>   apply modules, or all modules currently in the safe tier
  --remove <id...|safe>  remove modules, or all modules currently in the safe tier
  --version             show the installed release or checkout version
  upgrade               install the newest release of the tool
  -h, --help            show this help

Module IDs: audio eq color suspend boot 5k
  suspend blocks sleep; it does not repair suspend or hibernate.

--force may appear anywhere. It bypasses only the Retina 5K model gate;
individual module compatibility checks still apply. Run as your desktop user.
Use safe on its own, or name one or more module IDs. Module prompts still apply.
Exit status: 0 = success/skip, 1 = operation failed, 2 = invalid arguments.
USAGE
}

module_exists() {
    local id
    for id in "${MODULES[@]}"; do
        [[ $1 == "$id" ]] && return 0
    done
    return 1
}

parse_args() {
    ACTION=interactive
    FORCE=0
    REQUESTED_MODULES=()
    local arg command_seen=0
    for arg in "$@"; do
        case "$arg" in
            --force) FORCE=1 ;;
            -h|--help|--status|--version|--apply|--remove|upgrade)
                (( command_seen == 0 )) || { warn "choose only one command" >&2; return 2; }
                command_seen=1
                ACTION=${arg#--}
                [[ $arg == -h ]] && ACTION=help ;;
            *)
                if [[ $ACTION != apply && $ACTION != remove ]]; then
                    warn "unexpected argument: $arg (try --help)" >&2; return 2
                fi
                if [[ $arg != safe ]] && ! module_exists "$arg"; then
                    warn "unknown module: $arg (ids: ${MODULES[*]})" >&2; return 2
                fi
                REQUESTED_MODULES+=("$arg") ;;
        esac
    done
    if [[ $ACTION == apply || $ACTION == remove ]]; then
        ((${#REQUESTED_MODULES[@]})) || { warn "--${ACTION} needs module IDs or safe" >&2; return 2; }
        if [[ " ${REQUESTED_MODULES[*]} " == *" safe "* ]] && ((${#REQUESTED_MODULES[@]} > 1)); then
            warn "use safe on its own, without other module IDs" >&2; return 2
        fi
    fi
    return 0
}
parse_args "$@" || exit "$?"

# ── version and upgrade ───────────────────────────────────────────────────
PROJECT_REPO=MarkPronkin/imac5k-universal-linux-patcher
RELEASES_API="${IMAC5K_API_URL:-https://api.github.com/repos/${PROJECT_REPO}/releases}"

# A release tarball carries a VERSION file; a git checkout does not, so fall
# back to describing the checkout.
imac_version() {
    if [[ -r "${REPO_DIR}/VERSION" ]]; then cat "${REPO_DIR}/VERSION"
    else git -C "$REPO_DIR" describe --tags --always --dirty 2>/dev/null || echo unknown; fi
}
imac_latest_release() {
    # Newest release including pre-releases, which /releases/latest hides.
    curl -fsSL -H 'Accept: application/vnd.github+json' "${RELEASES_API}?per_page=1" \
        | grep -o '"tag_name"[[:space:]]*:[[:space:]]*"[^"]*"' \
        | head -1 | sed 's/.*"\([^"]*\)"$/\1/'
}
imac_upgrade() {
    # Upgrading means replacing the tree this script is running from, which only
    # makes sense for a release install; a checkout is upgraded by git.
    if [[ ! -r "${REPO_DIR}/VERSION" ]]; then
        warn "this is a git checkout, not a release install"
        say  "upgrade it with:  git -C ${REPO_DIR} pull"
        return 1
    fi
    command -v curl >/dev/null || { warn "curl is needed to check for a new release"; return 1; }
    local current latest installer
    current="$(imac_version)"
    say "installed ${current} — checking for a newer release"
    latest="$(imac_latest_release)"
    [[ -n $latest ]] || { warn "could not reach ${RELEASES_API} — try again later"; return 1; }
    if [[ ${latest#v} == "$current" ]]; then
        say "already on the newest release (${current})"
        return 0
    fi
    say "upgrading ${current} → ${latest#v}"
    # Run the installer from a copy: it replaces the directory this script and
    # that installer both live in. The tarball it fetches carries the installer
    # for the next upgrade, so each release bootstraps the one after it.
    installer="$(mktemp)" || return 1
    if [[ -r "${REPO_DIR}/install.sh" ]]; then
        cat "${REPO_DIR}/install.sh" > "$installer"
    else
        curl -fsSL "https://raw.githubusercontent.com/${PROJECT_REPO}/main/install.sh" -o "$installer" \
            || { warn "could not download the installer"; rm -f "$installer"; return 1; }
    fi
    bash "$installer" --version "$latest"; local rc=$?
    rm -f "$installer"
    (( rc == 0 )) && say "patches already applied stay applied — check with: imac-patcher --status"
    return "$rc"
}
case "$ACTION" in
    help)      usage; exit 0 ;;
    version)   imac_version; exit 0 ;;
    upgrade)   imac_upgrade; exit ;;
esac

# ── hardware gate ──────────────────────────────────────────────────────────
product="$(imac_product_name)"
if ! imac_is_retina5k "$product" && (( ${FORCE:-0} == 0 )); then
    echo "This tool targets Retina 5K iMacs (detected: ${product}). Refusing. Use --force to override." >&2
    exit 1
fi

# ── core dependencies ──────────────────────────────────────────────────────
#
# Core tools are required to run the patcher. The status display also lists
# missing module tools; their full install/build preflights run when selected.
#
# "<command> <package>" pairs; the two package sets agree on these names.
CORE_DEPS=(
    "grep grep"
    "sed sed"
    "awk gawk"           # the 5K helpers parse with awk
    "find findutils"
    "sudo sudo"
)
# Check commands, not just one representative of the coreutils package: a
# minimal PATH or partial installation can expose install but omit mkdir/head.
for core_tool in readlink dirname cat uname mkdir install head tail cut sort tr \
                 cp mv rm ln mktemp date df du nproc tee touch sync sha256sum \
                 basename realpath seq sleep; do
    CORE_DEPS+=("$core_tool coreutils")
done

core_deps_check() {
    local entry cmd pkg missing=() packages=()
    for entry in "${CORE_DEPS[@]}"; do
        read -r cmd pkg <<<"$entry"
        command -v "$cmd" >/dev/null && continue
        missing+=("$cmd")
        [[ " ${packages[*]} " == *" $pkg "* ]] || packages+=("$pkg")
    done
    ((${#missing[@]})) || { say "Core dependencies: ready"; return 0; }

    warn "missing: ${missing[*]}"
    local installer=()
    if imac_is_fedora; then
        command -v dnf >/dev/null && installer=(sudo dnf install -y)
    elif command -v pacman >/dev/null; then installer=(sudo pacman -S --needed --noconfirm)
    elif command -v dnf    >/dev/null; then installer=(sudo dnf install -y)
    fi
    # Without sudo there is no way to run the package manager either, so say so
    # once instead of failing again inside the install.
    if ((${#installer[@]} == 0)) || [[ " ${packages[*]} " == *" sudo "* ]]; then
        warn "install these as root, then re-run: ${packages[*]}"
        return 1
    fi
    say "the patcher needs these packages: ${packages[*]}"
    confirm "Install them now?" || { warn "cannot run without: ${missing[*]}"; return 1; }
    "${installer[@]}" "${packages[@]}" || { warn "dependency installation failed — cannot continue"; return 1; }
    hash -r
    for cmd in "${missing[@]}"; do
        command -v "$cmd" >/dev/null || { warn "${cmd} is still missing after the install"; return 1; }
    done
    say "Core dependencies installed and verified"
}
core_deps_check || exit 1
mkdir -p "$LOGDIR" "$CACHE" || exit 1

# ═══════════════════════ module: audio ═════════════════════════════════════
AUDIO_REPO=https://github.com/jackdanyell/imac18-3-cs8409-linux-audio
AUDIO_SRC="${CACHE}/imac18-3-cs8409-linux-audio"
# The headset patch is verified against this exact tree. Use a distinct DKMS
# version so an existing 0.2 registration cannot silently reuse an old build.
# Bump AUDIO_DKMS_VERSION whenever the bundled driver changes.
AUDIO_PIN=be90113a7638eb264b2ff5acfe888cd72c8364c6
AUDIO_PATCH="${REPO_DIR}/patches/cs8409-headset-capture.patch"
AUDIO_DKMS=snd_hda_macbookpro
AUDIO_DKMS_VERSION=0.2.imac5k1
AUDIO_MODULES_DIR=/usr/lib/modules
AUDIO_DKMS_TREE=/var/lib/dkms
mod_audio_title() { echo "Speakers, headphones & mics"; }
mod_audio_tier()  { echo safe; }
mod_audio_desc()  { echo "Installs the iMac18,3 CS8409 driver with headset capture, microphone gain, live plug/unplug switching and EarPods remote buttons. DKMS rebuilds it after kernel updates; reboot after installation."; }

audio_kernel_supported() {
    local version=${1%%-*} major minor
    major=${version%%.*}; minor=${version#*.}; minor=${minor%%.*}
    [[ $major =~ ^[0-9]+$ && $minor =~ ^[0-9]+$ ]] || return 1
    # Older kernels use a different HDA patch which lacks the new spec fields.
    (( major > 6 || (major == 6 && minor >= 17) ))
}

audio_check_hardware() {
    imac_audio_supported || { warn "The bundled CS8409 driver supports only iMac18,3; keep this model's existing audio driver."; return 1; }
    local codec
    for codec in /sys/bus/hdaudio/devices/*/chip_name; do
        [[ -f $codec && $(cat "$codec") == CS8409* ]] && return 0
    done
    warn "CS8409 codec was not detected."
    return 1
}

audio_target_kernels() {
    # On rolling Arch the running kernel's headers may have been replaced.
    # Build every installed supported kernel with headers, including a pending
    # update, without making the old running kernel a prerequisite.
    local dir kernel
    for dir in "$AUDIO_MODULES_DIR"/*; do
        [[ -f $dir/build/Module.symvers ]] || continue
        kernel=${dir##*/}
        audio_kernel_supported "$kernel" && printf '%s\n' "$kernel"
    done
    return 0
}

audio_installed_is_ours() {
    # Resolve the actual module depmod selected, not the first .ko found on
    # disk: another DKMS package can install the same module name.
    local path params
    path=$(modinfo -k "$1" -n snd_hda_codec_cs8409 2>/dev/null) || return 1
    [[ $path == */updates/* || $path == */extra/* ]] || return 1
    params=$(modinfo -F parm "$path" 2>/dev/null) || return 1
    [[ $'\n'$params == *$'\n'headset_buttons:* ]]
}

audio_live_is_patched() {
    # A freshly replaced .ko does not tell us what is already in memory.
    [[ -r /sys/module/snd_hda_codec_cs8409/parameters/headset_buttons ]] || return 1
    local live installed
    live=$(cat /sys/module/snd_hda_codec_cs8409/srcversion 2>/dev/null) || return 1
    installed=$(modinfo -k "$KREL" -F srcversion snd_hda_codec_cs8409 2>/dev/null) || return 1
    [[ -n $live && $live == "$installed" ]]
}

audio_kernel_ready() {
    local status line
    status=$(dkms status -m "$AUDIO_DKMS" -v "$AUDIO_DKMS_VERSION" -k "$1" 2>/dev/null) || return 1
    while IFS= read -r line; do
        if [[ $line == "$AUDIO_DKMS/$AUDIO_DKMS_VERSION, $1, "*": installed"* ]]; then
            audio_installed_is_ours "$1"
            return
        fi
    done <<< "$status"
    return 1
}

audio_conflicts() {
    # Read config text, never source a rival package's shell code. Leave its
    # files and package registration to the owning package manager.
    local status name version rest conf
    status=$(dkms status 2>/dev/null) || return 1
    while IFS='/,:' read -r name version rest; do
        [[ -n $name && $name != "$AUDIO_DKMS" ]] || continue
        [[ $name =~ ^[a-zA-Z0-9_.+-]+$ && $version =~ ^[a-zA-Z0-9_.+-]+$ ]] || continue
        conf="$AUDIO_DKMS_TREE/$name/$version/source/dkms.conf"
        if grep -Eqi 'BUILT_MODULE_NAME.*cs8409' "$conf" 2>/dev/null; then
            printf '%s/%s\n' "$name" "$version"
        fi
    done <<< "$status"
}

mod_audio_detect() {
    imac_audio_supported || { echo n/a; return; }
    local status path kernels kernel ready=1 any=0
    status=$(dkms status -m "$AUDIO_DKMS" 2>/dev/null)
    path=$(modinfo -k "$KREL" -n snd_hda_codec_cs8409 2>/dev/null)
    [[ -n $status || $path == */updates/* || $path == */extra/* ]] && any=1
    kernels=$(audio_target_kernels)
    [[ -n $kernels ]] || kernels=$KREL
    while IFS= read -r kernel; do
        audio_kernel_ready "$kernel" || ready=0
    done <<< "$kernels"
    [[ -z $(audio_conflicts) ]] || ready=0
    if (( ready )) && audio_live_is_patched; then echo applied
    elif (( any )); then echo partial
    else echo not-applied; fi
}

audio_prepare_source() {   # export into $1; keep edits in the cached clone intact
    [[ -f $AUDIO_PATCH ]] || { warn "audio patch missing: $AUDIO_PATCH"; return 1; }
    if [[ ! -d $AUDIO_SRC/.git ]]; then
        say "cloning driver source into $AUDIO_SRC"
        git clone --no-checkout "$AUDIO_REPO" "$AUDIO_SRC" || return 1
    fi
    if ! git -C "$AUDIO_SRC" cat-file -e "${AUDIO_PIN}^{commit}" 2>/dev/null; then
        git -C "$AUDIO_SRC" fetch --depth 1 origin "$AUDIO_PIN" || return 1
    fi
    say "preparing pinned audio driver ${AUDIO_PIN:0:12} with headset fixes"
    git -C "$AUDIO_SRC" archive "$AUDIO_PIN" | tar -x -C "$1" || return 1
    patch -d "$1" -p1 --dry-run --batch --forward --fuzz=0 < "$AUDIO_PATCH" >/dev/null || {
        warn "headset patch does not apply to the pinned driver; no driver was replaced"; return 1;
    }
    patch -d "$1" -p1 --batch --forward --fuzz=0 < "$AUDIO_PATCH" || return 1
    sed -i "s/^PACKAGE_VERSION=\"0.2\"$/PACKAGE_VERSION=\"${AUDIO_DKMS_VERSION}\"/" "$1/dkms.conf" || return 1
    grep -Fxq "PACKAGE_VERSION=\"${AUDIO_DKMS_VERSION}\"" "$1/dkms.conf"
}

audio_install_driver() (
    # DKMS add copies the prepared tree into /usr/src. A failed download/patch
    # never removes the installed driver, and future rebuilds need no cache.
    local kernels kernel conflicts status stage
    kernels=$(audio_target_kernels)
    [[ -n $kernels ]] || { warn "No supported kernel with matching headers found (audio needs Linux 6.17+)."; return 1; }
    conflicts=$(audio_conflicts) || { warn "Could not inspect DKMS registrations."; return 1; }
    [[ -z $conflicts ]] || {
        warn "Conflicting CS8409 DKMS package(s): $conflicts"
        warn "Remove the conflicting driver with its package manager, then retry audio."
        return 1
    }
    stage=$(mktemp -d "${CACHE}/audio-build.XXXXXX") || return 1
    trap 'rm -rf "$stage"' EXIT
    audio_prepare_source "$stage" || return 1
    status=$(dkms status -m "$AUDIO_DKMS" -v "$AUDIO_DKMS_VERSION") || return 1
    [[ $status != *broken* ]] || {
        warn "Broken registration: run sudo dkms remove $AUDIO_DKMS/$AUDIO_DKMS_VERSION --all, then retry."
        return 1
    }
    if [[ -z $status ]]; then
        sudo dkms add "$stage" || return 1
    fi
    while IFS= read -r kernel; do
        if ! audio_kernel_ready "$kernel"; then
            # Build before replacing the old version for this kernel. DKMS
            # retains older versions installed for other fallback kernels.
            sudo dkms build -m "$AUDIO_DKMS" -v "$AUDIO_DKMS_VERSION" -k "$kernel" || return 1
            sudo dkms install -m "$AUDIO_DKMS" -v "$AUDIO_DKMS_VERSION" -k "$kernel" --force || return 1
        fi
        audio_kernel_ready "$kernel" || { warn "The patched CS8409 driver was not installed for $kernel."; return 1; }
        say "headset driver installed for $kernel"
    done <<< "$kernels"
)

audio_arch_deps() {
    local tool pkg missing=() packages=()
    for tool in dkms wget git gcc make patch tar xz modinfo depmod; do
        command -v "$tool" >/dev/null && continue
        missing+=("$tool")
        case $tool in gcc|make) pkg=base-devel ;; modinfo|depmod) pkg=kmod ;; *) pkg=$tool ;; esac
        [[ " ${packages[*]} " == *" $pkg "* ]] || packages+=("$pkg")
    done
    [[ -n $(audio_target_kernels) ]] || packages+=(linux-headers)
    if ((${#packages[@]})); then
        warn "missing packages: ${packages[*]}"
        confirm "Install them now?" || return 1
        sudo pacman -S --needed --noconfirm "${packages[@]}" || return 1
    fi
    for tool in "${missing[@]}"; do
        command -v "$tool" >/dev/null || { warn "$tool is still missing after installation."; return 1; }
    done
    [[ -n $(audio_target_kernels) ]] || { warn "Install headers matching an installed Linux 6.17+ kernel, then retry."; return 1; }
}

audio_refresh_initramfs() {
    if command -v limine-mkinitcpio >/dev/null; then sudo limine-mkinitcpio
    elif command -v mkinitcpio >/dev/null; then sudo mkinitcpio -P
    else warn "mkinitcpio is required to refresh the installed audio modules."; return 1; fi
}

mod_audio_apply() {
    audio_check_hardware || return 1
    command -v limine-mkinitcpio >/dev/null || command -v mkinitcpio >/dev/null || {
        warn "mkinitcpio is required to refresh the installed audio modules."; return 1;
    }
    audio_arch_deps || return 1
    audio_install_driver || return 1
    audio_refresh_initramfs || return 1
    say "installed — reboot to load the headset fixes"
}

audio_remove_driver() {
    local status name version rest versions=()
    status=$(dkms status -m "$AUDIO_DKMS") || return 1
    while IFS='/,:' read -r name version rest; do
        [[ $name == "$AUDIO_DKMS" && $version =~ ^[a-zA-Z0-9_.+-]+$ ]] || continue
        [[ " ${versions[*]} " == *" $version "* ]] || versions+=("$version")
    done <<< "$status"
    for version in "${versions[@]}"; do
        sudo dkms remove "$AUDIO_DKMS/$version" --all || return 1
    done
}

mod_audio_remove() {
    audio_remove_driver || return 1
    audio_refresh_initramfs || return 1
    say "stock module restored — reboot to load it"
}

# ═══════════════════════ module: eq ════════════════════════════════════════
#
# Speaker tuning by taprobane99 (github.com/taprobane99/iMac5KLinux), measured
# with a calibrated microphone: a PipeWire filter-chain that crosses the four
# speaker channels over at 3.8 kHz, EQs each way, and convolves each with a
# measured impulse response. Only the Audio/ part of that project is used --
# nothing of its kernel, display or GRUB work is touched here.
#
# The tuning is vendored under assets/imac-audio rather than downloaded at
# apply time. It used to be fetched from that project's main branch, which made
# every install depend on whatever main happened to be: its iMacAudio.conf was
# rewritten three times inside one hour on 2026-09-03, and a change to the graph
# reaches users as a tuning that sounds different, or as a sink that does not
# load at all. See assets/imac-audio/README.md for provenance and licence.
EQ_ASSETS="${SCRIPT_DIR}/../assets/imac-audio"
# The graph runs in a PipeWire client of its own, not in the session daemon,
# so that headphone switching can take the tuned sink away and put it back: a
# module loaded by the daemon lives exactly as long as the daemon does. The
# downloaded graph stays a drop-in beside the base config, byte-identical to
# what upstream publishes; only the base config is this tool's own.
EQ_BASE_CONF="${HOME}/.config/pipewire/imac-speaker-eq.conf"
EQ_CONF_DIR="${EQ_BASE_CONF}.d"
EQ_CONF="${EQ_CONF_DIR}/imac-audio.conf"
# Where installs from before headphone switching put the graph. Left in place
# it would load a second, unstoppable copy of the chain.
EQ_LEGACY_CONF="${HOME}/.config/pipewire/pipewire.conf.d/imac-audio.conf"
# Upstream installs the impulse responses to /usr/share with sudo. They are
# read by the user's own PipeWire daemon and referenced from a config in the
# user's home, so they live beside it here: the whole module then needs root
# for nothing but the plugin packages, and removing it leaves no root-owned
# files behind. The paths inside the config are rewritten to match.
EQ_UPSTREAM_IRS_DIR=/usr/share/imac-audio
EQ_IRS_DIR="${XDG_DATA_HOME:-${HOME}/.local/share}/imac-audio"
EQ_IRS=("Filters L Aug 14-MP.wav" "Filters R Aug 14-MP.wav"
        "Filters C2 Aug 16-MP.wav" "Filters LFE Aug 16-MP.wav")
EQ_SINK=audio_effect.iMac-convolver
# The chain's own output is a playback stream, so desktops list it beside real
# applications: upstream calls it "iMac Speakers DSP Out" and it shows up while
# the speakers play. Omarchy's audio panel already skips a tuning's output, but
# recognises it by name -- any playback stream whose node.name starts with
# "omarchy_speaker_tuning". Renaming ours into that convention is what takes it
# out of the list; elsewhere it is just a node name nothing reads.
EQ_DSP_NODE=omarchy_speaker_tuning_imac5k_output
EQ_UPSTREAM_DSP_NODE=effect_output.iMac-convolver
EQ_UNIT_DIR="${HOME}/.config/systemd/user"
EQ_UNIT=imac-speaker-eq.service
EQ_JACK_UNIT=imac-audio-jack.service
EQ_JACK_SRC="${SCRIPT_DIR}/imac-audio-jack-switch"
EQ_JACK_BIN="${HOME}/.local/bin/imac-audio-jack-switch"
# What the jack output is called once the card leaves the 4.0 profile. The
# tuning is measured for the internal drivers and is not applied to it.
EQ_AUX_DESC="Aux Audio Output"
# bankstown, the psychoacoustic bass extension the chain starts with, is
# packaged only in the AUR and not at all for Fedora -- so this module used to
# need an AUR helper on Arch and a manual build everywhere else. The AUR package
# is nothing but `cargo build --release` and an install of three files, so doing
# that here removes the helper requirement without changing what is installed.
# MIT licensed, unlike the tuning, and unchanged upstream since 2023.
EQ_BANKSTOWN_REPO="${IMAC5K_BANKSTOWN_URL:-https://github.com/chadmed/bankstown}"
EQ_BANKSTOWN_PIN=e9829c9bccf5ed73768135c0ddd506f5a6690f9e   # tag 1.1.0
EQ_BANKSTOWN_SRC="${CACHE}/bankstown"
# LV2 hosts search here by default, so the build needs no root and --remove
# takes it away again.
EQ_LV2_USER_DIR="${HOME}/.lv2"
EQ_BANKSTOWN_BUNDLE="${EQ_LV2_USER_DIR}/bankstown.lv2"
# Written only when this module built it, so removal cannot take away a bundle
# the user built or placed there themselves.
EQ_BANKSTOWN_STATE="${LOGDIR}/eq-bankstown"
EQ_HIDE_RULE="${HOME}/.config/wireplumber/wireplumber.conf.d/51-imac-hide-raw-speakers.conf"
EQ_PROFILE_40='output:analog-surround-40+input:analog-stereo'
EQ_PROFILE_STATE="${LOGDIR}/eq-card-profile"
EQ_VOLUME_STATE="${LOGDIR}/eq-hardware-volume"

mod_eq_title() { echo "Speaker tuning (4.0 DSP)"; }
mod_eq_tier()  { echo safe; }
mod_eq_desc()  { echo "The codec does no DSP at all; macOS's warmth is entirely software. Drives the woofers and tweeters as separate channels through a measured crossover, EQ and convolution chain. Plugging headphones in hides it and exposes an untuned ${EQ_AUX_DESC}."; }

# The built-in speakers are one 4-channel card: two stereo speaker pins, which
# PulseAudio/PipeWire present as the "Analog Surround 4.0" profile. That is
# also how the card is told apart from HDMI here -- no other card offers it.
# LC_ALL=C because pactl translates these labels.
eq_card() {   # prints "<card name> <active profile>"
    LC_ALL=C pactl list cards 2>/dev/null | awk '
        /^Card #/                                  { name=""; active=""; has40=0 }
        /^\tName: /                                { name=$2 }
        $1 == "'"${EQ_PROFILE_40}"':"              { has40=1 }
        /^\tActive Profile: /                      { active=$3
                                                     if (has40 && name) { print name, active; exit } }'
}

eq_headphones_present() {
    # The raw sink can be hidden, but the card still publishes jack presence.
    # Only a positively available headphone port on THIS card counts.
    LC_ALL=C pactl list cards 2>/dev/null | awk -v card="$1" '
        /^Card #/ { name="" }
        /^\tName: / { name=$2 }
        name == card && $1 == "analog-output-headphones:" && /, available\)$/ { found=1 }
        END { exit !found }'
}

# The flat output the card exposes once a headphone plug has moved it off the
# 4.0 profile. Derived from the card rather than matched by pattern: a USB DAC
# presents an "analog-stereo" sink too, and must not be mistaken for the jack.
eq_aux_sink() { printf 'alsa_output.%s.analog-stereo' "${1#alsa_card.}"; }

eq_sink_exists() {
    LC_ALL=C pactl list short sinks 2>/dev/null | awk -v n="$1" '$2 == n { f=1 } END { exit !f }'
}

# The tuned sink becomes the default only over a built-in output or the dummy
# sink: re-applying while the user listens through a USB DAC or Bluetooth must
# not yank their output back. The jack switcher's claim_default makes the same
# call on plug and unplug.
eq_claim_default() {   # $1 = card
    local current
    current=$(LC_ALL=C pactl get-default-sink 2>/dev/null)
    case "$current" in
        "$EQ_SINK") return 0 ;;
        ""|auto_null|*"${1#alsa_card.}"*)
            pactl set-default-sink "$EQ_SINK" 2>/dev/null \
                && say "default output set to the tuned sink" ;;
        *) say "default output left on ${current}" ;;
    esac
}

eq_units_installed() {
    command -v systemctl >/dev/null || return 1
    [[ -f "${EQ_UNIT_DIR}/${EQ_UNIT}" && -f "${EQ_UNIT_DIR}/${EQ_JACK_UNIT}" ]] || return 1
    systemctl --user is-enabled --quiet "$EQ_UNIT" 2>/dev/null || return 1
    systemctl --user is-enabled --quiet "$EQ_JACK_UNIT" 2>/dev/null || return 1
}

# Both units are pulled in by pipewire.service, so a restart of the audio stack
# brings them back by itself. Stopping them first is what keeps a re-apply from
# racing: the chain must not come up while the card is still on stereo.
eq_stop_units() {
    command -v systemctl >/dev/null || return 0
    local unit
    for unit in "$EQ_JACK_UNIT" "$EQ_UNIT"; do
        systemctl --user stop "$unit" 2>/dev/null || true
    done
}

eq_write_base_conf() {
    mkdir -p "$EQ_CONF_DIR" || return 1
    cat > "$EQ_BASE_CONF" <<'CONF'
# Written by imac-patcher; removed by `imac-patcher --remove eq`.
#
# A PipeWire client that hosts nothing but the speaker tuning graph, run by
# imac-speaker-eq.service. The graph itself is the drop-in beside this file.
#
# It is here rather than in pipewire.conf.d so the tuned sink can be taken away
# and put back with the service: a graph loaded by the daemon exists for as
# long as the daemon does, and headphone switching needs it gone. The module
# list below is the stock standalone-filter preamble, as shipped in
# /usr/share/pipewire/filter-chain.conf.
context.properties = {
    log.level = 0
}

context.spa-libs = {
    audio.convert.* = audioconvert/libspa-audioconvert
    support.*       = support/libspa-support
}

context.modules = [
    { name = libpipewire-module-rt
        args = { }
        flags = [ ifexists nofail ]
    }
    { name = libpipewire-module-protocol-native }
    { name = libpipewire-module-client-node }
    { name = libpipewire-module-adapter }
]
CONF
}

eq_install_jack_helper() {
    [[ -f $EQ_JACK_SRC ]] || { warn "jack switching helper missing: ${EQ_JACK_SRC}"; return 1; }
    install -Dm755 "$EQ_JACK_SRC" "$EQ_JACK_BIN"
}

# WantedBy=pipewire.service, not default.target: both follow the audio stack,
# including a restart of it, and neither is any use without one.
eq_write_units() {
    mkdir -p "$EQ_UNIT_DIR" || return 1
    cat > "${EQ_UNIT_DIR}/${EQ_UNIT}" <<'UNIT'
# Written by imac-patcher; removed by `imac-patcher --remove eq`.
[Unit]
Description=iMac 5K speaker tuning (PipeWire filter chain)
After=pipewire.service pipewire-session-manager.service
BindsTo=pipewire.service

[Service]
Type=simple
ExecStart=/usr/bin/pipewire -c imac-speaker-eq.conf
Restart=on-failure
Slice=session.slice
LockPersonality=yes
MemoryDenyWriteExecute=yes
NoNewPrivileges=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=pipewire.service
UNIT
    cat > "${EQ_UNIT_DIR}/${EQ_JACK_UNIT}" <<'UNIT'
# Written by imac-patcher; removed by `imac-patcher --remove eq`.
[Unit]
Description=iMac 5K headphone jack output switching
After=pipewire.service pipewire-session-manager.service
BindsTo=pipewire.service

[Service]
Type=simple
ExecStart=%h/.local/bin/imac-audio-jack-switch
Restart=always
RestartSec=2
Slice=session.slice

[Install]
WantedBy=pipewire.service
UNIT
}

# An LV2 plugin is present when its bundle is, wherever the distribution keeps
# bundles -- checking package names would need one list per distribution.
# NB: LV2_PATH is usually unset, and this script runs under `set -u`, where
# expanding an unset variable is fatal to the whole process -- not to the
# function. ${LV2_PATH:-} first, or a machine without it dies here, silently,
# before a single message has been printed.
eq_have_lv2() {   # $1 = bundle directory name
    local dir search="${LV2_PATH:-}"
    for dir in ${search//:/ } /usr/lib/lv2 /usr/lib64/lv2 /usr/local/lib/lv2 "${HOME}/.lv2"; do
        [[ -d "${dir}/$1" ]] && return 0
    done
    return 1
}

# Builds the pinned release into the user's own bundle directory. A distribution
# package, where one exists, is found by eq_have_lv2 first and nothing is built.
eq_build_bankstown() (
    local tool build
    for tool in git cargo; do
        command -v "$tool" >/dev/null || {
            warn "${tool} is needed to build bankstown (see DEPENDENCIES.md)"; return 1; }
    done
    mkdir -p "$CACHE" || return 1
    if [[ ! -d $EQ_BANKSTOWN_SRC/.git ]]; then
        say "cloning bankstown into ${EQ_BANKSTOWN_SRC}"
        git clone --no-checkout "$EQ_BANKSTOWN_REPO" "$EQ_BANKSTOWN_SRC" || return 1
    fi
    if ! git -C "$EQ_BANKSTOWN_SRC" cat-file -e "${EQ_BANKSTOWN_PIN}^{commit}" 2>/dev/null; then
        git -C "$EQ_BANKSTOWN_SRC" fetch --depth 1 origin "$EQ_BANKSTOWN_PIN" || return 1
    fi
    build=$(mktemp -d "${CACHE}/bankstown-build.XXXXXX") || return 1
    trap 'rm -rf "$build"' EXIT
    # Exported rather than built in the cached clone, so a user's own edits or
    # a dirty checkout there cannot end up in what is installed.
    git -C "$EQ_BANKSTOWN_SRC" archive "$EQ_BANKSTOWN_PIN" | tar -x -C "$build" || return 1
    say "building bankstown ${EQ_BANKSTOWN_PIN:0:12} with cargo -- this takes a minute"
    # --locked: build the dependency versions upstream resolved, not whatever
    # crates.io offers today.
    ( cd "$build" && cargo build --release --locked ) || {
        warn "bankstown did not build; see the cargo output above"; return 1; }
    # The Makefile's install target, pointed at the user's bundle directory.
    install -Dm755 "${build}/target/release/libbankstown.so" \
        "${EQ_BANKSTOWN_BUNDLE}/bankstown.so" || return 1
    install -Dm644 "${build}/bankstown.ttl" "${EQ_BANKSTOWN_BUNDLE}/bankstown.ttl" || return 1
    install -Dm644 "${build}/manifest.ttl" "${EQ_BANKSTOWN_BUNDLE}/manifest.ttl" || return 1
    eq_have_lv2 bankstown.lv2 || {
        warn "bankstown was built but is not in ${EQ_LV2_USER_DIR}"; return 1; }
    printf '%s\n' "$EQ_BANKSTOWN_PIN" > "$EQ_BANKSTOWN_STATE" || return 1
    say "bankstown installed to ${EQ_BANKSTOWN_BUNDLE}"
)

# The card profile counts. With the card on stereo the chain still loads and
# still produces four channels -- the two woofer ones just link to nothing, and
# the machine plays the tweeter half of a crossover: quiet and thin, while
# every file is in place. That is a "partial", not an "applied".
#
# Headphones are the exception. With the jack in use the tuning is *supposed*
# to be stopped and the card is *supposed* to be on stereo, so looking for the
# tuned sink and the 4.0 profile would report a working install as broken. What
# is checked then is the state that should hold instead: the flat jack output.
mod_eq_detect() {
    command -v pactl >/dev/null || { echo n/a; return; }
    local conf=0 irs=1 units=0 jack=0 output=0 pin=0 f card profile
    [[ -f $EQ_BASE_CONF && -f $EQ_CONF ]] && conf=1
    for f in "${EQ_IRS[@]}"; do [[ -f "${EQ_IRS_DIR}/${f}" ]] || irs=0; done
    eq_units_installed && units=1
    [[ -x $EQ_JACK_BIN ]] && jack=1
    read -r card profile <<<"$(eq_card)"
    # An install from before the chain's output was pinned to the 4.0 device
    # has every file in place but follows the default device onto USB DACs; it
    # needs re-applying, so the pin counts toward "applied".
    if [[ -n ${card:-} && -f $EQ_CONF ]] && grep -qs -- \
            "\"target.object\": \"alsa_output.${card#alsa_card.}.analog-surround-40\"" "$EQ_CONF"; then
        pin=1
    fi
    if [[ -n ${card:-} ]] && eq_headphones_present "$card"; then
        eq_sink_exists "$(eq_aux_sink "$card")" && output=1
    else
        [[ $(LC_ALL=C pactl list sinks short 2>/dev/null) == *"$EQ_SINK"* ]] \
            && [[ ${profile:-} == "$EQ_PROFILE_40" ]] && output=1
    fi
    if   (( conf && irs && units && jack && output && pin )); then echo applied
    elif (( conf || irs || units || jack || output )); then echo partial
    else echo not-applied; fi
}

# lsp-plugins carries the loudness compensation and the woofer compressors;
# bankstown is the psychoacoustic bass extension the chain starts with. A
# missing plugin does not degrade the graph -- PipeWire drops the whole filter
# node and the sink never appears -- so both are required, not optional.
eq_plugins() {
    local missing=() repo=() build=0
    eq_have_lv2 lsp-plugins.lv2 || { missing+=("lsp-plugins (LV2)"); repo+=(lsp-plugins-lv2); }
    eq_have_lv2 bankstown.lv2   || { missing+=("bankstown (LV2)");   build=1; }
    ((${#missing[@]})) || return 0
    warn "missing LV2 plugins: ${missing[*]}"
    ((${#repo[@]})) && say "  sudo pacman -S --needed ${repo[*]}    (dnf install on Fedora)"
    ((build)) && say "  bankstown is not in any distribution repository; it is built from source"

    if ((${#repo[@]})); then
        if   command -v pacman >/dev/null; then
            confirm "Install ${repo[*]} with pacman?" || return 1
            sudo pacman -S --needed --noconfirm "${repo[@]}" || return 1
        elif command -v dnf >/dev/null; then
            confirm "Install ${repo[*]} with DNF?" || return 1
            sudo dnf install -y "${repo[@]}" || return 1
        else
            warn "install the LSP LV2 plugins with your package manager, then re-run"; return 1
        fi
    fi
    # Built here rather than installed from the AUR: an AUR helper is an Arch-only
    # answer, and it would leave Fedora with no answer at all. The AUR package
    # itself only runs cargo, so this installs the same 1.1.0 build -- into the
    # user's own ~/.lv2, so it needs no root and --remove can take it away.
    if ((build)); then
        confirm "Build bankstown from source into ${EQ_LV2_USER_DIR}?" || return 1
        eq_build_bankstown || return 1
    fi
    eq_have_lv2 lsp-plugins.lv2 && eq_have_lv2 bankstown.lv2 && return 0
    warn "the plugins are still missing after the install"; return 1
}

# Checked before anything is installed, so a checkout missing the tuning says
# so instead of leaving a half-installed graph that cannot load.
eq_assets_present() {
    local f
    for f in iMacAudio.conf "${EQ_IRS[@]}"; do
        [[ -s "${EQ_ASSETS}/${f}" ]] || {
            warn "the speaker tuning is missing from this checkout: ${EQ_ASSETS}/${f}"
            warn "re-install the tool, or fetch the release archive again."
            return 1
        }
    done
}

mod_eq_apply() {
    local card profile
    read -r card profile <<<"$(eq_card)"
    [[ -n ${card:-} ]] || {
        warn "no built-in speaker card offering ${EQ_PROFILE_40}."
        if imac_audio_supported; then
            warn "Apply the audio module first, then reboot -- the stock driver exposes no speakers."
        else
            warn "EQ requires a working built-in four-channel speaker driver for ${product:-this model}."
        fi
        return 1
    }
    if eq_headphones_present "$card"; then
        warn "Unplug headphones before applying speaker EQ; its tuning and hardware level are for the internal speakers."
        return 1
    fi
    command -v pw-cli >/dev/null && command -v wpctl >/dev/null || {
        warn "pw-cli and wpctl are needed to set the hidden speaker volume (install PipeWire tools and WirePlumber)"
        return 1
    }
    eq_assets_present || return 1
    eq_plugins        || return 1

    local src="$EQ_ASSETS" f
    for f in "${EQ_IRS[@]}"; do
        install -Dm644 "${src}/${f}" "${EQ_IRS_DIR}/${f}" || return 1
    done
    install -Dm644 "${src}/iMacAudio.conf" "$EQ_CONF" || return 1
    sed -i "s|${EQ_UPSTREAM_IRS_DIR}/|${EQ_IRS_DIR}/|g" "$EQ_CONF" || return 1
    grep -qs -- "${EQ_IRS_DIR}/" "$EQ_CONF" || {
        warn "the upstream config no longer points at ${EQ_UPSTREAM_IRS_DIR} -- check ${EQ_CONF}"; return 1; }
    # Cosmetic, unlike the paths above, so a config that no longer carries the
    # name upstream used is worth saying out loud but not worth refusing over.
    sed -i "s|\"${EQ_UPSTREAM_DSP_NODE}\"|\"${EQ_DSP_NODE}\"|" "$EQ_CONF" || return 1
    grep -qs -- "$EQ_DSP_NODE" "$EQ_CONF" \
        || warn "could not rename the tuning's output node; it will be listed as an application"
    # Pin the chain's output to the four-channel speaker device. Upstream sets
    # no target, so WirePlumber treats that playback node like any other
    # stream: it links to the default device and re-links every time the
    # default changes. Plug in a USB DAC and the measured crossover and EQ are
    # folded into its two channels, playing on the DAC. Functional, unlike the
    # rename above, so a config without the anchor is refused.
    local target="alsa_output.${card#alsa_card.}.analog-surround-40"
    sed -i "s|\"playback.props\": {|\"playback.props\": {\n                \"target.object\": \"${target}\",\n                \"node.dont-move\": \"true\",|" "$EQ_CONF" || return 1
    grep -qs -- "\"target.object\": \"${target}\"" "$EQ_CONF" || {
        warn "could not pin the tuning to the 4.0 speaker device -- check ${EQ_CONF}"; return 1; }
    eq_write_base_conf || return 1
    eq_write_hide_rule "$card" || return 1
    eq_install_jack_helper || return 1
    eq_write_units || return 1
    # An install from before headphone switching loaded the same graph in the
    # daemon. Left behind it is a second copy of the chain that no service can
    # stop, so the tuned sink would never go away for the jack.
    rm -f "$EQ_LEGACY_CONF"

    # Remember what the card was on, so --remove can put it back rather than
    # guessing at stereo. Written once: re-applying must not overwrite it with
    # the 4.0 profile this module itself selected.
    if [[ ! -f $EQ_PROFILE_STATE && -n ${profile:-} && $profile != "$EQ_PROFILE_40" ]]; then
        printf '%s\n' "$profile" > "$EQ_PROFILE_STATE"
    fi
    # Order matters here. The units are stopped first so that a re-apply does
    # not bring the chain up against whichever profile WirePlumber restores;
    # the profile is selected while nothing is running; the units start last,
    # onto a card that is already where the tuning expects it.
    eq_stop_units
    eq_restart_pipewire
    # Only now: WirePlumber re-applies its own stored profile as it comes back,
    # so a profile selected before the restart is quietly undone -- the graph
    # then feeds a stereo sink, the two woofer channels link to nothing, and
    # the result is the tweeter half of a crossover and nothing else. Selecting
    # it afterwards also stores it as the preference, so it survives a reboot.
    eq_select_profile || {
        warn "could not select ${EQ_PROFILE_40} on ${card}"; return 1; }
    systemctl --user daemon-reload 2>/dev/null || true
    systemctl --user enable --now "$EQ_UNIT" "$EQ_JACK_UNIT" >/dev/null 2>&1 || {
        warn "could not start ${EQ_UNIT} and ${EQ_JACK_UNIT}"; return 1; }
    # The daemon answers before it has finished loading the filter graph.
    local i
    for i in $(seq 10); do
        [[ $(mod_eq_detect) == applied ]] && break
        sleep 1
    done
    if [[ $(mod_eq_detect) == applied ]]; then
        eq_set_hardware_volume "$card" || return 1
        eq_claim_default "$card"
        say "hardware output is at 100%; adjust listening volume with iMac Speakers"
        say "headphones now hide it and expose ${EQ_AUX_DESC}, untuned"
    else
        warn "the tuned sink did not appear -- see: journalctl --user -u ${EQ_UNIT} -n 40"
        return 1
    fi
}

# Internal sinks are absent from pactl's sink list. Resolve the exact native
# node name each time: numeric PipeWire IDs change when the stack restarts.
eq_node_id() {
    LC_ALL=C pw-cli ls Node 2>/dev/null | awk -v name="\"$1\"" '
        $1 == "id" { id=$2; sub(/,$/, "", id) }
        $1 == "node.name" && $3 == name { print id }'
}

eq_node_volume() {
    LC_ALL=C wpctl get-volume "$1" 2>/dev/null | awk '
        $1 == "Volume:" && $2 ~ /^[0-9]+([.][0-9]+)?$/ { print $2 }'
}

eq_set_hardware_volume() {
    if eq_headphones_present "$1"; then
        warn "Unplug headphones before adjusting the speaker hardware level."
        return 1
    fi
    local hw tuned volume visible i
    for i in $(seq 10); do
        hw=$(eq_node_id "alsa_output.${1#alsa_card.}.analog-surround-40")
        [[ $hw =~ ^[0-9]+$ ]] && break
        sleep 0.5
    done
    [[ $hw =~ ^[0-9]+$ ]] || {
        warn "could not find the hidden 4.0 speaker output"; return 1; }
    volume=$(eq_node_volume "$hw")
    [[ -n $volume ]] || { warn "could not read the hardware volume"; return 1; }
    # Keep the pre-install level for --remove, including across re-applies.
    if [[ ! -f $EQ_VOLUME_STATE ]]; then
        printf '%s\n' "$volume" > "$EQ_VOLUME_STATE" || return 1
    fi
    if awk -v v="$volume" 'BEGIN { exit !(v < 1) }'; then
        tuned=$(eq_node_id "$EQ_SINK")
        [[ $tuned =~ ^[0-9]+$ ]] || {
            warn "could not find the tuned sink to lower its volume"; return 1; }
        visible=$(eq_node_volume "$tuned")
        [[ -n $visible ]] || { warn "could not read the tuned sink volume"; return 1; }
        # Lower BEFORE raising the hardware level. Preserve quieter settings
        # and leave the user's slider alone when re-applying at unity gain.
        if awk -v v="$visible" 'BEGIN { exit !(v > 0.45) }'; then
            wpctl set-volume "$tuned" 45% || {
                warn "could not lower the tuned sink volume"; return 1; }
            say "iMac Speakers volume lowered to 45% before raising the hardware output"
        fi
    fi
    # wpctl updates the ALSA route as well as the node; WirePlumber saves it.
    wpctl set-volume "$hw" 100% || {
        warn "could not set the hidden speaker output to 100%"; return 1; }
}

eq_restore_hardware_volume() {
    [[ -f $EQ_VOLUME_STATE ]] || return 0
    local hw volume
    volume=$(cat "$EQ_VOLUME_STATE")
    [[ $volume =~ ^[0-9]+([.][0-9]+)?$ ]] || {
        warn "invalid saved hardware volume in ${EQ_VOLUME_STATE}"; return 1; }
    hw=$(eq_node_id "alsa_output.${1#alsa_card.}.analog-surround-40")
    [[ $hw =~ ^[0-9]+$ ]] && wpctl set-volume "$hw" "$volume" || {
        warn "could not restore the saved hardware volume; keeping ${EQ_VOLUME_STATE}"; return 1; }
    rm -f "$EQ_VOLUME_STATE"
}

# On the 4.0 profile the raw device stops being a speaker pair: FL/FR are the
# tweeters, RL/RR the woofers. A stereo app that picks it directly gets the
# tweeters plus whatever PipeWire's upmixer derives for the rear -- thin and
# quiet -- so it is marked internal while the tuning is installed. It stays a
# real node the chain links to; it is only the pickers that lose it, because
# the PulseAudio layer exposes media.class "Audio/Sink" and nothing else.
# Both the description and the nick are set: pickers differ on which they show,
# and Omarchy's shows the nick, which ALSA fills in with the codec's own name.
eq_write_hide_rule() {   # $1 = card
    mkdir -p "$(dirname "$EQ_HIDE_RULE")" || return 1
    cat > "$EQ_HIDE_RULE" <<RULE
# Written by imac-patcher; removed by \`imac-patcher --remove eq\`.
#
# Hides the raw 4.0 speaker device, which the DSP chain feeds, from sound
# pickers: selected directly it plays the tweeter half of a crossover.
#
# The second rule names the same card's stereo device, which is what the card
# exposes once a headphone plug has moved it off the 4.0 profile. Matched by
# exact name rather than by pattern: a USB DAC also presents an "analog-stereo"
# sink, and renaming that one would be wrong.
monitor.alsa.rules = [
  {
    matches = [ { node.name = "~alsa_output.*analog-surround-40" } ]
    actions = { update-props = { media.class = "Audio/Sink/Internal" } }
  }
  {
    matches = [ { node.name = "$(eq_aux_sink "$1")" } ]
    actions = { update-props = {
      node.description = "${EQ_AUX_DESC}"
      node.nick = "${EQ_AUX_DESC}"
      device.icon-name = "audio-headphones"
    } }
  }
]
RULE
}

eq_select_profile() {   # idempotent; the card takes a moment after a restart
    local i card profile
    for i in $(seq 10); do
        read -r card profile <<<"$(eq_card)"
        [[ ${profile:-} == "$EQ_PROFILE_40" ]] && return 0
        [[ -n ${card:-} ]] && pactl set-card-profile "$card" "$EQ_PROFILE_40" 2>/dev/null
        sleep 1
    done
    return 1
}

mod_eq_remove() {
    local card profile restore=output:analog-stereo+input:analog-stereo
    read -r card profile <<<"$(eq_card)"
    [[ -r $EQ_PROFILE_STATE ]] && restore="$(cat "$EQ_PROFILE_STATE")"
    # Restore while the hidden 4.0 node still exists, before exposing hardware
    # as the user's output again. Old installs have no saved volume to restore.
    eq_restore_hardware_volume "$card" || return 1
    if command -v systemctl >/dev/null; then
        systemctl --user disable --now "$EQ_UNIT" "$EQ_JACK_UNIT" >/dev/null 2>&1 || true
        rm -f "${EQ_UNIT_DIR}/${EQ_UNIT}" "${EQ_UNIT_DIR}/${EQ_JACK_UNIT}"
        systemctl --user daemon-reload 2>/dev/null || true
    fi
    rm -f "$EQ_CONF" "$EQ_BASE_CONF" "$EQ_LEGACY_CONF" "$EQ_HIDE_RULE" "$EQ_JACK_BIN"
    # Only a bundle this module built. A distribution's package is the package
    # manager's to remove, and one the user built themselves is theirs.
    if [[ -f $EQ_BANKSTOWN_STATE ]]; then
        rm -rf "$EQ_BANKSTOWN_BUNDLE" && rm -f "$EQ_BANKSTOWN_STATE"
        rmdir "$EQ_LV2_USER_DIR" 2>/dev/null || true
    fi
    # Only if this module is the last thing in it; a drop-in directory the user
    # put something else in is theirs.
    rmdir "$EQ_CONF_DIR" 2>/dev/null || true
    rm -rf "$EQ_IRS_DIR"
    eq_restart_pipewire
    # After the restart, for the same reason as in apply.
    read -r card profile <<<"$(eq_card)"
    if [[ -n ${card:-} ]]; then
        pactl set-card-profile "$card" "$restore" \
            && say "card profile restored to ${restore}" \
            && rm -f "$EQ_PROFILE_STATE"
    fi
    # Whatever the card is now offering: with the filter sink gone, that is the
    # hardware sink again.
    local hw
    hw=$(LC_ALL=C pactl list sinks short 2>/dev/null | awk '$2 ~ /^alsa_output/ {print $2; exit}')
    [[ -n ${hw:-} ]] && pactl set-default-sink "$hw" && say "default output restored to ${hw}"
}

# WirePlumber reads its rules at startup, so a changed hide/naming rule takes a
# restart of the session's audio stack. The tuning and jack units are pulled in
# by pipewire.service and come back with it on their own.
eq_restart_pipewire() {
    say "restarting the audio stack"
    # One unit at a time: a session that runs, say, no pipewire-pulse must not
    # cost the others their restart, and with it the config reload.
    local unit
    for unit in pipewire pipewire-pulse wireplumber; do
        systemctl --user restart "$unit" 2>/dev/null || true
    done
    local i
    for i in $(seq 10); do
        sleep 0.5
        LC_ALL=C pactl info >/dev/null 2>&1 && break
    done
}

# ═══════════════════════ module: color ═════════════════════════════════════
mod_color_title() { echo "Wide-gamut colour"; }
mod_color_tier()  { echo safe; }
mod_color_desc()  { echo "The panel is Display P3; Hyprland's default sRGB mode leaves everything oversaturated. Sets cm=\"dp3\" on the monitor."; }
mod_color_detect() {
    # The early Retina 5K panel predates the Display P3 models. KDE's EDID
    # backend overrides this implementation and can use its actual gamut.
    [[ $product != iMac15,1 ]] || { echo n/a; return; }
    [[ -f "$MONITORS_LUA" ]] || { echo n/a; return; }
    grep -q 'cm = "dp3"' "$MONITORS_LUA" && echo applied || echo not-applied
}
mod_color_apply() {
    [[ $product != iMac15,1 ]] || { warn "The iMac15,1 panel should not be forced to Display P3."; return 1; }
    [[ -f "$MONITORS_LUA" ]] || { warn "$MONITORS_LUA not found"; return 1; }
    cp "$MONITORS_LUA" "${MONITORS_LUA}.bak-$(date +%s)"
    if grep -q 'cm = "' "$MONITORS_LUA"; then
        sed -i 's/cm = "[a-z0-9]*"/cm = "dp3"/' "$MONITORS_LUA"
    else
        # add cm to the active (uncommented) hl.monitor line
        sed -i '/^hl\.monitor({/ s/ })$/, cm = "dp3" })/' "$MONITORS_LUA"
    fi
    grep -q 'cm = "dp3"' "$MONITORS_LUA" || { warn "could not edit $MONITORS_LUA — do it by hand"; return 1; }
    command -v hyprctl >/dev/null && hyprctl reload >/dev/null 2>&1
    say "applied: $(grep -o 'colorManagementPreset: .*' <(hyprctl monitors all 2>/dev/null) | head -1)"
}
mod_color_remove() {
    [[ -f "$MONITORS_LUA" ]] || return 0
    cp "$MONITORS_LUA" "${MONITORS_LUA}.bak-$(date +%s)"
    sed -i 's/, cm = "dp3"//; s/cm = "dp3"/cm = "auto"/' "$MONITORS_LUA"
    command -v hyprctl >/dev/null && hyprctl reload >/dev/null 2>&1
}

# ═══════════════════════ module: suspend ═══════════════════════════════════
mod_suspend_title() { echo "Block suspend/hibernate"; }
# Boot tier only while the retired idle=poll config is still there, since
# cleaning it up rebuilds the boot image; a clean system gets the safe tier.
mod_suspend_tier()  { boot_config_has "$NO_CSTATES_PARAM" && echo boot || echo safe; }
mod_suspend_desc()  { echo "Suspend and hibernate hard-hang this machine, every time — recovery is a hard power-cycle, and idle=poll does not rescue it. Masks all four sleep targets so nothing triggers them. Also removes the retired idle=poll boot config if present, rebuilding the boot image. Leave this off if sleep works on your model."; }
mod_suspend_detect() {
    local masked=0
    for t in "${SLEEP_TARGETS[@]}"; do
        [[ "$(systemctl is-enabled "$t" 2>/dev/null)" == masked ]] && (( masked++ ))
    done
    local stale=0
    boot_config_has "$NO_CSTATES_PARAM" && stale=1
    if (( masked == ${#SLEEP_TARGETS[@]} && ! stale )); then echo applied
    elif (( masked || stale )); then echo partial
    else echo not-applied; fi
}
# The idle=poll variant left a drop-in (and on older layouts a line in
# /etc/default/limine); applying or removing this module returns the boot
# config to stock either way.
suspend_drop_no_cstates() {
    local stale=0
    if sudo test -f "$NO_CSTATES_DROPIN"; then
        sudo rm -f "$NO_CSTATES_DROPIN"
        say "removed stale ${NO_CSTATES_DROPIN}"
        stale=1
    fi
    if grep -qs -- "$NO_CSTATES_PARAM" "$LIMINE_DEFAULT"; then
        sudo cp "$LIMINE_DEFAULT" "${LIMINE_DEFAULT}.backup-cstates-$(date +%s)"
        sudo sed -i "s| ${NO_CSTATES_PARAM}||" "$LIMINE_DEFAULT"
        say "removed ${NO_CSTATES_PARAM} from ${LIMINE_DEFAULT}"
        stale=1
    fi
    (( stale )) || return 0
    sync_boot_files && verify_cmdline '' "$NO_CSTATES_PARAM"
    say "reboot to restore idle C-states"
}
mod_suspend_apply() {
    sudo systemctl mask "${SLEEP_TARGETS[@]}" || return 1
    suspend_drop_no_cstates
}
mod_suspend_remove() {
    sudo systemctl unmask "${SLEEP_TARGETS[@]}"
    suspend_drop_no_cstates
    say "sleep re-enabled"
}

# ═══════════════════════ module: boot ══════════════════════════════════════
HYGIENE_HOOK=/etc/boot/hooks/post.d/95-limine-esp-hygiene
LIMINE_PKG_EFI=/usr/share/limine/BOOTX64.EFI

mod_boot_title() { echo "Boot config hygiene"; }
mod_boot_tier()  { echo boot; }
mod_boot_desc()  { echo "Repairs two ways the boot menu goes wrong on this machine: stray limine.conf copies that silently override the real one (so new snapshots never appear), and a UKI copied over the EFI fallback (so that boot route shows no menu at all). Installs a hook that keeps it that way."; }

# Everything here lives under /boot, which is root-only, so probe in one
# non-interactive sudo and fall back to n/a rather than prompting from a
# status listing.
mod_boot_detect() {
    sudo -n true 2>/dev/null || { echo n/a; return; }
    local shadows fallback_uki hook
    shadows="$(sudo -n bash -c 'n=0; for f in /boot/EFI/limine/limine.conf /boot/EFI/BOOT/limine.conf /boot/boot/limine/limine.conf /boot/limine/limine.conf; do [[ -f $f ]] && n=$((n+1)); done; echo $n')"
    fallback_uki="$(sudo -n bash -c 'f=/boot/EFI/BOOT/BOOTX64.EFI
        [[ -f $f ]] || { echo no; exit; }
        p=$(mktemp); trap "rm -f $p" EXIT
        objcopy -O binary --only-section=.cmdline "$f" "$p" 2>/dev/null
        [[ -s $p ]] && echo yes || echo no')"
    hook=no; [[ -x $HYGIENE_HOOK ]] && hook=yes

    if [[ $shadows == 0 && $fallback_uki == no && $hook == yes ]]; then echo applied
    elif [[ $shadows == 0 && $fallback_uki == no ]]; then echo partial
    else echo not-applied; fi
}

mod_boot_apply() {
    cat <<'EOF'

What this changes, and how to undo it:
  * deletes stray limine.conf copies under /boot/EFI (the real one at
    /boot/limine.conf is untouched; copies are archived first)
  * if the EFI fallback is a UKI, restores the Limine binary there
    (the UKI is kept as BOOTX64.UKI-bypass.backup)
  * installs a post.d hook so both stay correct after kernel updates

Recovery: boot the OpenCore route or a Snapshot entry; restore with
  sudo cp /boot/EFI/BOOT/BOOTX64.UKI-bypass.backup /boot/EFI/BOOT/BOOTX64.EFI
EOF
    confirm "Repair the boot configuration?" || return 1

    sudo mkdir -p /boot/limine-conf-shadow-backup
    local f
    for f in "${LIMINE_SHADOW_CONFIGS[@]}"; do
        sudo test -f "$f" || continue
        sudo cp -f "$f" "/boot/limine-conf-shadow-backup/$(printf '%s' "${f#/boot/}" | tr / _)"
        sudo rm -f "$f" && say "removed shadowing config $f"
    done

    if fallback_is_uki; then
        local src="$LIMINE_PKG_EFI"
        sudo test -f /boot/EFI/BOOT/BOOTX64.LIMINE.EFI.unused && src=/boot/EFI/BOOT/BOOTX64.LIMINE.EFI.unused
        sudo test -f "$src" || { warn "no Limine binary found to restore (looked in $LIMINE_PKG_EFI)"; return 1; }
        say "restoring Limine at the EFI fallback (was a UKI copy)"
        sudo cp -f "$FALLBACK_PATH" /boot/EFI/BOOT/BOOTX64.UKI-bypass.backup
        sudo cp -f "$src" "$FALLBACK_PATH"
    fi

    say "installing the ESP hygiene hook"
    sudo install -m755 "${SCRIPT_DIR}/95-limine-esp-hygiene" "$HYGIENE_HOOK"
    sudo sync
    say "done — the boot menu will now show on every boot route"
}

mod_boot_remove() {
    # The repaired layout is what stock Omarchy installs, so there is nothing
    # sensible to "undo" there; only the hook is ours to take back.
    sudo rm -f "$HYGIENE_HOOK"
    say "hygiene hook removed; the ESP layout is left as stock Omarchy installs it"
    warn "to restore the old UKI-over-fallback bypass: sudo cp /boot/EFI/BOOT/BOOTX64.UKI-bypass.backup ${FALLBACK_PATH}"
}

# ═══════════════════════ module: 5k ════════════════════════════════════════
mod_5k_title() { echo "Native 5K display"; }
mod_5k_tier()  { echo boot; }
mod_5k_desc()  { echo "Wakes the panel's second tile, stitches both into one 5120x2880 output and genlocks them. Rebuilds the amdgpu module for the running kernel (stock module backed up)."; }
mod_5k_detect() {
    local moddir="/usr/lib/modules/${KREL}/kernel/drivers/gpu/drm/amd"
    local backup swapped=0 conf=0 live=0 res=""
    backup="$(find "$moddir" -name 'amdgpu.ko*.stock-backup' 2>/dev/null | head -1)"
    [[ -n "$backup" ]] && swapped=1
    # Keep installed patches removable even if the GPU driver fails to load.
    ((swapped)) || imac_has_amdgpu || { echo n/a; return; }
    boot_config_has 'amdgpu.tiled_stitch=1' && conf=1
    grep -q 'amdgpu.tiled_stitch=1' /proc/cmdline 2>/dev/null && live=1
    command -v hyprctl >/dev/null && res="$(hyprctl monitors 2>/dev/null | grep -oE '5120x2880' | head -1)"
    if (( swapped && conf && live )) && [[ "$res" == "5120x2880" ]]; then echo applied
    elif (( swapped || conf || live )); then echo partial
    else echo not-applied; fi
}
mod_5k_preflight() {
    imac_has_amdgpu || { warn "The 5K display patch requires a GPU using amdgpu."; return 1; }
    local ok=1 missing=() pkgs=()
    if [[ " $SUPPORTED_5K_SERIES " != *" $KSERIES "* ]]; then
        warn "kernel ${KREL}: the 5K patch is verified only for series ${SUPPORTED_5K_SERIES}."
        warn "It needs re-porting by hand first (see patches/README.md RULE 1)."
        ok=0
    else
        say "kernel ${KREL} — supported"
    fi
    # Build dependencies. The underlying installer only checks gcc, so a missing
    # bc/pahole surfaces as a confusing failure 20 minutes into a compile.
    local t
    for t in gcc make ld bc pahole flex bison zstd curl tar; do
        command -v "$t" >/dev/null || missing+=("$t")
    done
    if (( ${#missing[@]} )); then
        warn "missing build tools: ${missing[*]}"
        for t in "${missing[@]}"; do case $t in
            gcc|make|ld|flex|bison) pkgs+=(base-devel) ;;
            *)                      pkgs+=("$t") ;;
        esac; done
        # de-duplicate
        mapfile -t pkgs < <(printf '%s\n' "${pkgs[@]}" | sort -u)
        say "install with:  sudo pacman -S --needed ${pkgs[*]}"
        if confirm "Install them now?"; then
            sudo pacman -S --needed --noconfirm "${pkgs[@]}" || ok=0
        else ok=0; fi
    else
        say "build tools present"
    fi
    if [[ -e "/usr/lib/modules/${KREL}/build/Module.symvers" ]]; then
        say "kernel headers present"
    else
        warn "linux-headers missing for ${KREL}"
        if confirm "Install linux-headers now?"; then
            sudo pacman -S --needed --noconfirm linux-headers || ok=0
        else ok=0; fi
    fi
    local free_gb
    free_gb=$(df --output=avail -BG "$HOME" 2>/dev/null | tail -1 | tr -dc 0-9)
    if (( ${free_gb:-0} >= 8 )); then say "disk space: ${free_gb}G free"
    else warn "only ${free_gb:-?}G free — the kernel source tree needs roughly 8G"; ok=0; fi
    # A pre-populated tree makes this minutes instead of tens of minutes.
    if [[ -d "${HOME}/.cache/kernel-5k-build/linux-${KREL%%-*}" ]]; then
        say "kernel source already prepared — build will be quick"
    else
        say "kernel source will be downloaded (~150M) and built: expect 20-40 min"
    fi
    return $(( 1 - ok ))
}
mod_5k_apply() {
    mod_5k_preflight || { warn "preflight failed — nothing was changed."; return 1; }
    printf '\n\033[1mRestore at any time:\033[0m  %s --remove 5k\n\n' "$0"
    confirm "Build and install the patched amdgpu module?" || return 1
    local log="$LOGDIR/apply-5k-$(date +%Y%m%d-%H%M%S).log"
    sudo "$INSTALLER_5K" 2>&1 | tee "$log" || return 1
    if boot_config_has "$VIDEO_4K" && confirm "Remove the 4K fallback parameter (required for real 5K)?"; then
        remove_4k_fallback
    fi
    sync_boot_files && verify_cmdline 'amdgpu.tiled_stitch=1' "$VIDEO_4K"
    say "reboot to activate"
}
mod_5k_remove() {
    sudo "$INSTALLER_5K" --restore || return 1
    sudo rm -f "$STITCH_DROPIN"
    # Older layouts appended the parameter straight into /etc/default/limine.
    if grep -qs 'amdgpu.tiled_stitch=1' "$LIMINE_DEFAULT"; then
        sudo cp "$LIMINE_DEFAULT" "${LIMINE_DEFAULT}.backup-restore-$(date +%s)"
        sudo sed -i 's| amdgpu.tiled_stitch=1||' "$LIMINE_DEFAULT"
    fi
    if ! boot_config_has "$VIDEO_4K" && confirm "Re-add the 4K fallback (recommended without 5K)?"; then
        add_4k_fallback
    fi
    sync_boot_files && verify_cmdline "" 'amdgpu.tiled_stitch=1'
    say "reboot to return to stock"
}

# ── boot helpers ───────────────────────────────────────────────────────────
#
# Omarchy builds the kernel cmdline from /etc/default/limine PLUS every
# /etc/limine-entry-tool.d/*.conf drop-in, each appending with `+=`. Reading
# /etc/default/limine alone sees none of what Omarchy actually sets, which is
# how `amdgpu.tiled_stitch=1` could read as missing while the 4K fallback in a
# drop-in read as absent and so was never offered for removal.
boot_config_has() {
    grep -qs -- "$1" "$LIMINE_DEFAULT" "$LIMINE_DROPIN_DIR"/*.conf
}

# The 4K fallback is a stock-amdgpu workaround: it pins eDP-1 to a single-tile
# 3840x2160 mode, which the stitched driver rejects. It has to go before 5K.
remove_4k_fallback() {
    local stamp; stamp="$(date +%s)"
    if sudo test -f "$FALLBACK_4K_DROPIN"; then
        # renamed, not deleted -- ".disabled-<stamp>" falls outside the *.conf
        # glob the entry tool reads, so it stops applying but stays recoverable
        sudo mv "$FALLBACK_4K_DROPIN" "${FALLBACK_4K_DROPIN}.disabled-${stamp}"
        say "disabled ${FALLBACK_4K_DROPIN} (kept as .disabled-${stamp})"
    fi
    if grep -qs -- "$VIDEO_4K" "$LIMINE_DEFAULT"; then
        sudo cp "$LIMINE_DEFAULT" "${LIMINE_DEFAULT}.backup-pre5k-${stamp}"
        sudo sed -i "s| ${VIDEO_4K}||" "$LIMINE_DEFAULT"
        say "removed ${VIDEO_4K} from ${LIMINE_DEFAULT}"
    fi
}

add_4k_fallback() {
    sudo mkdir -p "$LIMINE_DROPIN_DIR"
    printf '%s\n%s\n' \
        '# Written by imac-patcher; delete this file to drop the parameter.' \
        "KERNEL_CMDLINE[default]+=\" ${VIDEO_4K}\"" \
        | sudo tee "$FALLBACK_4K_DROPIN" >/dev/null
    say "wrote ${FALLBACK_4K_DROPIN}"
}

#
# Limine >= 10.3.0 loads the FIRST config in its search order, so a copy at
# EFI/limine/ or EFI/BOOT/ silently overrides /boot/limine.conf -- the file
# limine-mkinitcpio and limine-snapper-sync actually maintain. Earlier versions
# of this script *created* those copies, believing the ESP needed three kept in
# sync. It does not, and the copies cost a Snapper snapshot its boot entry on
# 2026-09-05. `limine-install` flags them; the fix is to delete them.
LIMINE_SHADOW_CONFIGS=(
    /boot/EFI/limine/limine.conf
    /boot/EFI/BOOT/limine.conf
    /boot/boot/limine/limine.conf
    /boot/limine/limine.conf
)
UKI_PATH=/boot/EFI/Linux/omarchy_linux.efi
FALLBACK_PATH=/boot/EFI/BOOT/BOOTX64.EFI

remove_shadow_configs() {
    local f
    for f in "${LIMINE_SHADOW_CONFIGS[@]}"; do
        sudo test -f "$f" || continue
        sudo rm -f "$f" && say "removed shadowing config $f"
    done
    return 0
}

# True when the EFI fallback is a UKI copy rather than the Limine binary.
# NB: `objcopy --only-section=X` exits 0 even when section X is absent -- it
# writes nothing. Testing its exit status calls every PE binary a UKI, which on
# a stock ESP means overwriting Limine with a kernel image. Check for bytes.
fallback_is_uki() {
    sudo bash -c 'p=$(mktemp); trap "rm -f $p" EXIT
        objcopy -O binary --only-section=.cmdline '"$FALLBACK_PATH"' "$p" 2>/dev/null
        [[ -s $p ]]' 2>/dev/null
}

sync_boot_files() {
    say "rebuilding UKI"
    sudo limine-mkinitcpio || return 1
    remove_shadow_configs
    # Only relevant on machines still running the old "UKI over the fallback"
    # bypass; on a stock ESP that path is Limine and must not be touched.
    if fallback_is_uki; then
        say "refreshing UKI-bypass fallback ${FALLBACK_PATH}"
        sudo cp -f "$UKI_PATH" "$FALLBACK_PATH" 2>/dev/null
    fi
    sudo sync
}
verify_cmdline() {   # $1 must be present, $2 must be absent
    # Read the UKI itself, not the EFI fallback: on a stock ESP the fallback is
    # the Limine binary and carries no .cmdline at all.
    local line
    line="$(sudo bash -c 'tmp=$(mktemp); trap "rm -f $tmp" EXIT; objcopy -O binary --only-section=.cmdline '"$UKI_PATH"' "$tmp" && tr -d "\0" < "$tmp"')"
    [[ -n "${1:-}" ]] && ! grep -q "$1" <<<"$line" && { warn "verify: embedded cmdline missing '$1'"; return 1; }
    [[ -n "${2:-}" ]] &&   grep -q "$2" <<<"$line" && { warn "verify: embedded cmdline still has '$2'"; return 1; }
    say "embedded cmdline verified"
}

# Fedora implementations use DNF, dracut and GRUB; KDE uses KScreen.
if imac_is_fedora; then source "${SCRIPT_DIR}/lib/fedora.sh"; fi
if imac_is_kde; then source "${SCRIPT_DIR}/lib/kde.sh"; fi

# ── generic driver ─────────────────────────────────────────────────────────
# One snapshot for the status display and its following menu. Actions always
# probe again in run_module: applying audio can change EQ's live prerequisites.
declare -A MODULE_STATES=() MODULE_TIERS=()

state_label() {
    case "$1" in
        applied)     printf '\033[1;32m✓ applied\033[0m' ;;
        not-applied) printf '\033[0;37m· not applied\033[0m' ;;
        partial)     printf '\033[1;33m⚠ partial\033[0m' ;;
        n/a)         printf '\033[0;37m— n/a\033[0m' ;;
    esac
}
show_status() {
    hdr "imac-patcher — ${product}, kernel ${KREL}"
    local m st tier badge
    MODULE_STATES=(); MODULE_TIERS=()
    for m in "${MODULES[@]}"; do
        st="$("mod_${m}_detect")"; tier="$("mod_${m}_tier")"
        MODULE_STATES[$m]=$st; MODULE_TIERS[$m]=$tier
        badge=''; [[ $tier == boot ]] && badge=$'\033[0;33m[boot]\033[0m'
        printf '  %-32s %-22b %s\n' "$("mod_${m}_title")" "$(state_label "$st")" \
            "$badge"
    done
    echo
    printf '  ids: %s\n' "${MODULES[*]}"
    startup_deps_note
    eq_prereq_note "${MODULE_STATES[eq]:-n/a}"
}

startup_deps_note() {
    # This audit must not depend on a module's successful detection: absent
    # pactl/python3 can make detection return n/a or nothing at all.
    local id tool reported=0 fedora=0 kde=0 tools=() missing=()
    imac_is_fedora && fedora=1
    imac_is_kde && kde=1
    for id in "${MODULES[@]}"; do
        [[ ${MODULE_STATES[$id]} == applied ]] && continue
        tools=(); missing=()
        case "$id" in
            audio)
                imac_audio_supported || continue
                tools=(dkms modinfo wget git gcc make patch tar xz depmod)
                ((fedora)) && tools+=(dracut mokutil)
                if ((fedora)); then
                    [[ -f /usr/lib/modules/${KREL}/build/Module.symvers ]] || missing+=("matching kernel development files")
                else
                    [[ -n $(audio_target_kernels) ]] || missing+=("matching kernel development files")
                fi ;;
            eq) tools=(pactl pw-cli wpctl systemctl)
                # Only when there is something to build: a machine that already
                # has bankstown packaged needs no Rust toolchain.
                eq_have_lv2 bankstown.lv2 || tools+=(git cargo) ;;
            color)
                if ((kde)); then tools=(python3 kscreen-doctor)
                elif [[ -f $MONITORS_LUA ]]; then tools=(hyprctl); fi ;;
            suspend)
                tools=(systemctl)
                ((fedora)) && tools+=(grubby) ;;
            boot)
                ((fedora)) && continue
                [[ -f $LIMINE_DEFAULT ]] || continue
                tools=(objcopy limine-mkinitcpio) ;;
            5k)
                [[ ${MODULE_STATES[$id]} == n/a ]] && continue
                tools=(gcc make ld strip objcopy bc pahole flex bison patch xz curl tar modinfo depmod)
                if ((fedora)); then tools+=(rpm rpmbuild koji python3 dracut grubby mokutil)
                else tools+=(zstd cpio limine-mkinitcpio); fi
                [[ -f /usr/lib/modules/${KREL}/build/Module.symvers ]] || missing+=("matching kernel development files") ;;
        esac
        for tool in "${tools[@]}"; do
            command -v "$tool" >/dev/null || missing+=("$tool")
        done
        ((${#missing[@]})) || continue
        printf '  %s missing dependencies: %s\n' "$id" "${missing[*]}"
        reported=1
    done
    if ((reported)); then
        printf '  Package names and setup: %s/DEPENDENCIES.md\n' "$REPO_DIR"
        printf '  Module dependencies are checked again when applying a patch.\n'
    fi
    return 0
}

# The startup gate covers what every run needs. These belong to one optional
# patch and one of them is a source build, so they are reported here rather
# than installed at launch on machines that will never apply it; the module
# offers to install them at the point where they are actually needed.
eq_prereq_note() {   # $1 = EQ state from the current status snapshot
    [[ $1 == applied || $1 == n/a ]] && return 0
    local missing=()
    eq_have_lv2 lsp-plugins.lv2 || missing+=(lsp-plugins-lv2)
    eq_have_lv2 bankstown.lv2   || missing+=("bankstown(built from source)")
    ((${#missing[@]})) || return 0
    printf '  eq needs %s — it offers to install them when you apply it\n' "${missing[*]}"
}
run_module() {   # $1 = apply|remove, $2 = id
    local action=$1 id=$2 st
    st="$("mod_${id}_detect")"
    [[ $st == n/a ]] && { say "${id}: not applicable on this machine — skipping"; return 0; }
    if [[ $action == apply && $st == applied ]]; then
        # Older EQ installs pass the file/profile checks but can retain a
        # quiet hidden hardware route. Repair it without downloading again.
        if [[ $id == eq ]]; then
            local card profile
            read -r card profile <<<"$(eq_card)"
            eq_set_hardware_volume "$card" || return 1
            say "eq: hardware output is at 100%; adjust listening volume with iMac Speakers"
        else
            say "${id}: already applied — skipping"
        fi
        return 0
    fi
    if [[ $action == remove && $st == not-applied ]]; then say "${id}: not applied — nothing to remove"; return 0; fi
    hdr "$( [[ $action == apply ]] && echo Applying || echo Removing ): $("mod_${id}_title")"
    if "mod_${id}_${action}"; then
        say "${id}: ${action} finished — now $("mod_${id}_detect")"
    else
        warn "${id}: ${action} failed (see messages above)"; return 1
    fi
}

run_modules() {   # $1 = apply|remove, remaining arguments = validated module IDs
    local action=$1 id result=0
    shift
    for id in "$@"; do
        run_module "$action" "$id" || result=1
    done
    return "$result"
}

run_safe_modules() {
    local action=$1 m result=0
    for m in "${MODULES[@]}"; do
        # A tier can change with boot config, so check it immediately before
        # the action instead of reusing the menu's snapshot.
        [[ $("mod_${m}_tier") == safe ]] || continue
        run_module "$action" "$m" || result=1
    done
    return "$result"
}

case "$ACTION" in
    status) show_status; exit 0 ;;
    apply|remove)
        if [[ ${REQUESTED_MODULES[0]} == safe ]]; then
            run_safe_modules "$ACTION"
        else
            run_modules "$ACTION" "${REQUESTED_MODULES[@]}"
        fi
        exit "$?" ;;
esac

# ── interactive ────────────────────────────────────────────────────────────
# The patch picker: every unapplied patch on its own row, Enter marks the one
# under the cursor, and the two rows below the list act on the marks. PICKED
# comes back holding the indexes that were marked; the return code says whether
# the user asked to install (0) or to leave (1).
PICK_INSTALL='Install selected'
PICK_EXIT='Exit patcher'
PICKED=()
MARKED=()

pick_count() { local m c=0; for m in "${MARKED[@]}"; do ((c += m)); done; printf '%d' "$c"; }
pick_collect() { local i; PICKED=(); for i in "${!MARKED[@]}"; do ((MARKED[i])) && PICKED+=("$i"); done; return 0; }

pick_render() {   # $1 = cursor row, $2 = notice line, rest = patch rows
    local cur=$1 notice=$2; shift 2
    local rows=("$@") n=$# i arrow mark
    printf '  Enter marks a patch · ↑/↓ or j/k moves · q leaves\n'
    printf '  \033[0;33m%s\033[0m\n\n' "$notice"
    for ((i = 0; i < n; i++)); do
        arrow='   '; ((i == cur)) && arrow=$'\033[1;36m ❯ \033[0m'
        mark='[ ]'; ((MARKED[i])) && mark=$'\033[1;32m[✓]\033[0m'
        printf '%s%s %s\n' "$arrow" "$mark" "${rows[i]}"
    done
    echo
    arrow='   '; ((cur == n))     && arrow=$'\033[1;36m ❯ \033[0m'
    printf '%s%s (%s)\n' "$arrow" "$PICK_INSTALL" "$(pick_count)"
    arrow='   '; ((cur == n + 1)) && arrow=$'\033[1;36m ❯ \033[0m'
    printf '%s%s\n' "$arrow" "$PICK_EXIT"
}

pick_done() { printf '\033[?25h'; exec 3<&-; }   # cursor back, terminal closed

pick_tui() {   # arrow-key picker; keys come off the terminal so stdin stays
    local rows=("$@") n=$# cur=0 notice='' lines key rest
    lines=$((n + 6))                        # what pick_render just drew
    # Keystrokes come off the terminal directly, so whatever a module later
    # reads from stdin is still waiting there for it.
    #
    # The braces matter: `exec 3</dev/tty 2>/dev/null` applies BOTH redirections
    # to the shell, permanently, so every later error message -- bash's own
    # included -- goes to /dev/null and modules fail in silence. Inside a group
    # the 2>/dev/null belongs to the group and ends with it.
    { exec 3</dev/tty; } 2>/dev/null || exec 3<&0
    printf '\033[?25l'
    while :; do
        pick_render "$cur" "$notice" "${rows[@]}"
        notice=''
        IFS= read -rsn1 -u 3 key || key=q
        [[ $key == $'\e' ]] && { read -rsn2 -t 0.05 -u 3 rest; key+=$rest; }
        case "$key" in
            $'\e[A'|k) ((cur = cur > 0 ? cur - 1 : n + 1)) ;;
            $'\e[B'|j) ((cur = cur < n + 1 ? cur + 1 : 0)) ;;
            ''|' ')
                if ((cur < n)); then
                    MARKED[cur]=$((1 - MARKED[cur]))
                elif ((cur == n)); then
                    if (($(pick_count))); then pick_done; pick_collect; return 0; fi
                    notice='nothing marked yet — press Enter on a patch first'
                else
                    pick_done; PICKED=(); return 1
                fi ;;
            q) pick_done; PICKED=(); return 1 ;;
        esac
        printf '\033[%dA\033[J' "$lines"
    done
}

pick_plain() {   # same choices, numbered, for a pipe or a dumb terminal
    local rows=("$@") n=$# i ans last=$(($# + 2))
    while :; do
        echo
        for ((i = 0; i < n; i++)); do
            printf '  %2d) %s %s\n' "$((i + 1))" \
                "$( ((MARKED[i])) && printf '[x]' || printf '[ ]')" "${rows[i]}"
        done
        printf '  %2d) %s (%s)\n' "$((n + 1))" "$PICK_INSTALL" "$(pick_count)"
        printf '  %2d) %s\n'      "$((n + 2))" "$PICK_EXIT"
        read -rp '  select: ' ans || { PICKED=(); return 1; }
        [[ $ans =~ ^[0-9]+$ ]] || continue
        # Strip leading zeros before arithmetic (Bash otherwise reads octal),
        # and reject oversized input before it can overflow into a valid row.
        ans=${ans#"${ans%%[!0]*}"}
        [[ -n $ans && ${#ans} -le ${#last} ]] || continue
        if   ((ans >= 1 && ans <= n)); then MARKED[ans - 1]=$((1 - MARKED[ans - 1]))
        elif ((ans == n + 1)); then pick_collect; return 0
        elif ((ans == n + 2)); then PICKED=(); return 1; fi
    done
}

pick_patches() {   # $@ = rows to offer; fills PICKED with the chosen indexes
    local i; MARKED=(); PICKED=()
    for ((i = 0; i < $#; i++)); do MARKED[i]=0; done
    if [[ -t 0 && -t 1 ]]; then pick_tui "$@"; else pick_plain "$@"; fi
}

show_status
echo
sel=''
if ((HAVE_GUM)); then
    sel=$(gum choose "Apply all safe patches" "Choose patches to apply" "Remove a patch" "Quit") || exit 0
else
    select sel in "Apply all safe patches" "Choose patches to apply" "Remove a patch" "Quit"; do break; done
fi
case "$sel" in
    "Apply all safe patches")
        run_safe_modules apply
        exit "$?" ;;
    "Choose patches to apply")
        ids=(); avail=(); for m in "${MODULES[@]}"; do
            st=${MODULE_STATES[$m]}; [[ $st == applied || $st == n/a ]] && continue
            ids+=("$m")
            avail+=("${m} — $("mod_${m}_title")$([[ ${MODULE_TIERS[$m]} == boot ]] && echo '  [boot]')")
        done
        (( ${#avail[@]} )) || { say "everything applicable is already applied"; exit 0; }
        # The picker gathers the whole selection before anything runs, so module
        # prompts and installers keep the terminal on stdin for themselves.
        pick_patches "${avail[@]}" || exit 0
        (( ${#PICKED[@]} )) || { say "nothing selected"; exit 0; }
        selected=()
        for i in "${PICKED[@]}"; do
            selected+=("${ids[i]}")
        done
        run_modules apply "${selected[@]}"
        exit "$?" ;;
    "Remove a patch")
        avail=(); for m in "${MODULES[@]}"; do
            [[ ${MODULE_STATES[$m]} =~ ^(applied|partial)$ ]] && avail+=("${m} — $("mod_${m}_title")")
        done
        (( ${#avail[@]} )) || { say "nothing to remove"; exit 0; }
        pick=''
        if ((HAVE_GUM)); then pick=$(gum choose "${avail[@]}") || exit 0; else
            select p in "${avail[@]}"; do pick=$p; break; done; fi
        [[ -n $pick ]] || exit 0
        run_module remove "${pick%% *}" ;;
    *) exit 0 ;;
esac
