diff --git a/src/helpers/cm/Edr.hpp b/src/helpers/cm/Edr.hpp
--- /dev/null
+++ b/src/helpers/cm/Edr.hpp
@@ -0,0 +1,26 @@
+#pragma once
+
+#include <algorithm>
+
+namespace NColorManagement::EDR {
+    struct SLuminanceTransform {
+        float sourceEncodingPeak;
+        float targetEncodingPeak;
+        float sourceContentPeak;
+    };
+
+    // Work in absolute luminance between decode and encode. Anchoring reference
+    // white here makes tagged SDR, untagged SDR and HDR agree. The second pass
+    // (linear working buffer -> panel) has matching reference whites, so scales
+    // by one. Absolute, unnormalised internal buffers already contain nits.
+    inline SLuminanceTransform luminanceTransform(float sourceEncodingPeak, float sourceReference, float sourceContentPeak,
+                                                  float targetEncodingPeak, float targetReference,
+                                                  bool sourceIsAbsolute = false) {
+        const float scale = sourceIsAbsolute ? 1.F : targetReference / std::max(sourceReference, 1.F);
+        return {
+            .sourceEncodingPeak = sourceEncodingPeak * scale,
+            .targetEncodingPeak = targetEncodingPeak,
+            .sourceContentPeak = (sourceContentPeak > 0 ? sourceContentPeak : sourceEncodingPeak) * scale,
+        };
+    }
+}
